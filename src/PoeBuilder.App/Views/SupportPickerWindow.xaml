<Window x:Class="PoeBuilder.App.Views.SupportPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Support gem" Width="540" Height="620" MinWidth="460" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
 FontFamily="Segoe UI" UseLayoutRounding="True" ShowInTaskbar="False">
 <Grid Margin="20,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="20" Foreground="{StaticResource Gold}"/>
   <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <TextBox Grid.Row="1" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,12,0,10"/>
  <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedGem}" Background="#0D1319" Foreground="{StaticResource Text}"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnDoubleClick">
   <ListBox.ItemTemplate><DataTemplate>
    <Grid Margin="3,5">
     <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="34" Height="34" CornerRadius="17" BorderBrush="{Binding Color,Converter={StaticResource GemBrush}}" BorderThickness="1.6" Background="#10161C">
      <Image Source="{Binding Converter={StaticResource GemIcon}}" Width="28" Height="28"/>
     </Border>
     <StackPanel Grid.Column="1" Margin="10,0,0,0">
      <TextBlock Text="{Binding Name}" FontSize="13"/>
      <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
     </StackPanel>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="{Binding CancelLabel}" Click="OnCancel" MinWidth="110" Margin="0,0,10,0"/>
   <Button Content="{Binding PickLabel}" Click="OnPick" Style="{StaticResource PrimaryButton}" MinWidth="150"/>
  </StackPanel>
 </Grid>
</Window>
