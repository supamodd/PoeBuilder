<Window x:Class="PoeBuilder.App.Views.ItemEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Width="1500" Height="980" MinWidth="1180" MinHeight="720" ResizeMode="CanResize"
 WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
 FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" ShowInTaskbar="False">
 <Grid Margin="22,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
  <TextBlock Text="{Binding Title}" FontFamily="{StaticResource AppFontBold}" FontSize="26" Foreground="{StaticResource Gold}"/>
   <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Error,Converter={StaticResource EmptyVisibility}}"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,12,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="270"/><ColumnDefinition Width="6"/><ColumnDefinition Width="0.9*" MinWidth="300"/><ColumnDefinition Width="6"/><ColumnDefinition Width="1.15*" MinWidth="400"/></Grid.ColumnDefinitions>
   <!-- Base browser -->
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding L[ItemBase]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
    <!-- MinHeight, not Height: the theme's own minimum is what keeps a full text line inside the box, and a fixed
         Height here fought it, leaving the search field shorter than the line it has to show. -->
    <TextBox Grid.Row="1" MinHeight="46" VerticalAlignment="Top" Text="{Binding BaseSearch,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" ToolTip="{Binding L[BaseSearch]}"/>
    <ListBox Grid.Row="1" Margin="0,54,0,0" ItemsSource="{Binding Bases}" SelectedItem="{Binding SelectedChoice}" Background="#0D1319" Foreground="{StaticResource Text}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
     <ListBox.ItemTemplate><DataTemplate>
      <Grid Margin="2,4">
       <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"/>
       <StackPanel Grid.Column="1" Margin="8,0,0,0">
        <TextBlock Text="{Binding Name}" FontSize="16.5" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding ClassName}" FontSize="14" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
     <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>
   <!-- Game-like tooltip preview -->
  <Border Grid.Column="2" Background="#E60C1015" BorderBrush="#4A4A44" BorderThickness="1" CornerRadius="4" Padding="14,10" VerticalAlignment="Stretch">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl ItemsSource="{Binding Preview}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <TextBlock Text="{Binding Text}" FontSize="{Binding Size}" FontWeight="{Binding Bold,Converter={StaticResource BoolToBold}}" Foreground="{Binding Brush}" TextWrapping="Wrap" Margin="0,0.5"/>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
   </Border>
     <GridSplitter Grid.Column="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>
   <!-- Fields + mods + socketables -->
  <!-- The fields panel is shown for a new item too. It used to be collapsed while IsNewItem was set, which is
       exactly when the owner could not find "quality": the panel they had to pick a base in was missing the one
       field a crafted item is judged by. The base list is already on the left, so nothing is lost by showing it. -->
  <ScrollViewer Grid.Column="4" MinWidth="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="{Binding L[ItemName]}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
       <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/>
      </StackPanel>
      <!-- Rarity only. The separate "unique item" picker is gone on purpose: uniques live in the same pool
           as the bases on the left (SelectedChoice picks either), so a second list could only disagree with it. -->
      <StackPanel Grid.Column="2" Width="190">
       <TextBlock Text="{Binding L[ItemRarity]}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
       <ComboBox ItemsSource="{Binding Rarities}" SelectedItem="{Binding Rarity}" DisplayMemberPath="Name"/>
      </StackPanel>
     </Grid>
     <!-- Level, quality and sockets sit on one row so none of them is pushed off the panel by the name field. -->
     <UniformGrid Columns="3" Margin="0,12,0,0">
      <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding L[ItemLevel]}" Foreground="{StaticResource Muted}" Margin="0,0,0,6" FontSize="15"/><TextBox Text="{Binding ItemLevel,UpdateSourceTrigger=PropertyChanged}" MaxLength="3"/></StackPanel>
      <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding L[ItemQuality]}" Foreground="{StaticResource Muted}" Margin="0,0,0,6" FontSize="15"/><TextBox Text="{Binding Quality,UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/></StackPanel>
      <StackPanel><TextBlock Text="{Binding L[ItemSockets]}" Foreground="{StaticResource Muted}" Margin="0,0,0,6" FontSize="15"/><TextBox Text="{Binding Capacity,UpdateSourceTrigger=PropertyChanged}" MaxLength="1"/></StackPanel>
     </UniformGrid>
     <TextBlock Text="{Binding L[QualityNote]}" Style="{StaticResource MutedText}" FontSize="14.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <!-- Unique lines: PoB2's own data for this unique, filtered by the variant the game uses. -->
     <StackPanel Visibility="{Binding IsUniqueDraft,Converter={StaticResource BoolVisibility}}">
      <Grid Margin="0,14,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal">
        <Image Source="{Binding ItemIcon}" Width="44" Height="44" Stretch="Uniform" Margin="0,0,10,0"/>
        <StackPanel>
         <TextBlock Text="{Binding L[UniqueLines]}" Style="{StaticResource Eyebrow}"/>
         <TextBlock Text="{Binding UniqueVariantLabel}" Foreground="{StaticResource Muted}" FontSize="14.5" Margin="0,4,0,0"/>
        </StackPanel>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="{Binding L[UniqueVariant]}" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,0,0,6"/>
        <ComboBox ItemsSource="{Binding UniqueVariantChoices}" SelectedItem="{Binding SelectedUniqueVariant}" DisplayMemberPath="Name"
                  Visibility="{Binding HasUniqueVariants,Converter={StaticResource BoolVisibility}}" MaxDropDownHeight="260"/>
        <CheckBox Content="{Binding L[UniqueAllVariants]}" IsChecked="{Binding ShowAllVariants}" FontSize="15" Margin="0,6,0,0"/>
       </StackPanel>
      </Grid>
      <TextBlock Text="{Binding L[UniqueVariantsHint]}" Style="{StaticResource MutedText}" FontSize="14.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <ItemsControl ItemsSource="{Binding UniqueLines}" Margin="0,8,0,0">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
         <StackPanel>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <!-- The game colours the implicit and explicit blocks differently; the badges make that split
                explicit in the editor, so a line is never mistaken for the wrong kind of modifier. -->
           <Border Background="#14303C" CornerRadius="3" Padding="6,2" Visibility="{Binding IsImplicit,Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding DataContext.L[UniqueImplicitBadge],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="13" Foreground="#6FB8DC"/>
           </Border>
           <Border Grid.Column="0" Background="#1C2228" CornerRadius="3" Padding="6,2" Visibility="{Binding IsImplicit,Converter={StaticResource BoolVisibility},ConverterParameter=Invert}">
            <TextBlock Text="{Binding DataContext.L[UniqueExplicitBadge],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="13" Foreground="#8F9BA6"/>
           </Border>
           <TextBlock Grid.Column="1" Text="{Binding Marker}" Foreground="{StaticResource Gold}" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"
                      Visibility="{Binding Marker,Converter={StaticResource EmptyVisibility}}"/>
           <Button Grid.Column="2" Content="✕" Width="28" Margin="6,0,0,0" Command="{Binding RemoveCommand}" Style="{StaticResource QuietButton}"
                   ToolTip="{Binding DataContext.L[RemoveLine],RelativeSource={RelativeSource AncestorType=Window}}"/>
          </Grid>
          <TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Template}" FontSize="16" Margin="0,6,0,0"/>
          <!-- Roll editor: a line with one numeric range takes its value straight here. The typed roll is
               clamped to the data's min–max and rewritten into the item text on the fly. -->
          <Grid Visibility="{Binding HasValueRange,Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding DataContext.L[UniqueRoll],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/>
           <TextBox Grid.Column="1" Text="{Binding Roll,UpdateSourceTrigger=PropertyChanged}" FontSize="15" VerticalContentAlignment="Center" Margin="8,0"/>
           <TextBlock Grid.Column="2" Text="{Binding RollRangeCaption}" Foreground="{StaticResource Gold}" FontSize="14" VerticalAlignment="Center"/>
          </Grid>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding L[UniqueNotesHint]}" Style="{StaticResource MutedText}" FontSize="14.5" TextWrapping="Wrap" Margin="0,8,0,0"
                 Visibility="{Binding HasUniqueLines,Converter={StaticResource BoolVisibility},ConverterParameter=Invert}"/>
     </StackPanel>

     <TextBlock Text="{Binding L[CurrentMods]}" Style="{StaticResource Eyebrow}" Margin="0,16,0,8"
                 Visibility="{Binding IsUniqueDraft,Converter={StaticResource BoolVisibility},ConverterParameter=Invert}"/>
     <ItemsControl ItemsSource="{Binding Mods}"
                   Visibility="{Binding IsUniqueDraft,Converter={StaticResource BoolVisibility},ConverterParameter=Invert}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="{Binding Text}" FontSize="16.5" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" FontSize="13.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
         <TextBox Grid.Column="1" Text="{Binding ValuesText,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="10,0"/>
         <Button Grid.Column="2" Content="×" Width="32" Command="{Binding RemoveCommand}" Style="{StaticResource QuietButton}" ToolTip="{Binding DataContext.L[RemoveMod],RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <!-- Every "add" button rides the section header instead of standing in a narrow right-hand column next to
          the search box. In that column the button was the first thing to be pushed out of the panel when the
          window narrowed, while the list it belongs to stayed visible — the exact "I can see the mods but not
          the button" case. A header row gives the button the full panel width. -->
     <Grid Margin="0,16,0,8" Visibility="{Binding IsUniqueDraft,Converter={StaticResource BoolVisibility},ConverterParameter=Invert}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding L[AvailableMods]}" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="{Binding L[AddMod]}" Command="{Binding AddModCommand}" Padding="18,8" MinWidth="130"/>
     </Grid>
     <Grid Visibility="{Binding IsUniqueDraft,Converter={StaticResource BoolVisibility},ConverterParameter=Invert}">
      <StackPanel>
       <TextBox Text="{Binding ModSearch,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" ToolTip="{Binding L[ModSearch]}"/>
      <ListBox ItemsSource="{Binding AvailableMods}" SelectedItem="{Binding SelectedMod}" Height="220" Margin="0,8,0,0" Background="#0D1319" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,4"><TextBlock Text="{Binding DisplayName}" FontSize="15.5" TextWrapping="Wrap"/><TextBlock Text="{Binding Text}" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </Grid>
     <!-- The same "available mods" list for a unique: not catalog affixes (a unique has none) but the pool
          of its special mods — every rolled version PoB2 lists, e.g. Morior Invictus's per-socket "Spirit /
          Life / All Resistances" lines. Choosing one puts it straight onto the item's own lines. -->
     <Grid Margin="0,16,0,8" Visibility="{Binding IsUniqueDraft,Converter={StaticResource BoolVisibility}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding L[AvailableMods]}" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="{Binding L[AddMod]}" Command="{Binding AddUniqueLineCommand}" Padding="18,8" MinWidth="130"/>
     </Grid>
     <Grid Visibility="{Binding IsUniqueDraft,Converter={StaticResource BoolVisibility}}">
      <StackPanel>
       <TextBox Text="{Binding ModSearch,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" ToolTip="{Binding L[ModSearch]}"/>
      <ListBox ItemsSource="{Binding AvailableUniqueOptions}" SelectedItem="{Binding SelectedUniqueLineOption}" Height="220" Margin="0,8,0,0" Background="#0D1319" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" FontSize="15.5" TextWrapping="Wrap" Margin="3,4"/></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </Grid>
     <Grid Margin="0,16,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <CheckBox Content="{Binding L[ItemCorrupted]}" IsChecked="{Binding Corrupted}" Foreground="{StaticResource Text}" VerticalContentAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding L[CorruptedHint]}" Style="{StaticResource MutedText}" FontSize="14.5" TextWrapping="Wrap" Margin="12,0,0,0"/>
     </Grid>
     <ItemsControl ItemsSource="{Binding CorruptedList}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="#6B4438" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="{Binding Text}" FontSize="16.5" Foreground="#C86B5A" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" FontSize="13.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
         <TextBox Grid.Column="1" Text="{Binding ValuesText,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="10,0"/>
         <Button Grid.Column="2" Content="×" Width="32" Command="{Binding RemoveCommand}" Style="{StaticResource QuietButton}" ToolTip="{Binding DataContext.L[RemoveMod],RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <Grid Margin="0,16,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding L[ItemCorrupted]}" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="{Binding L[CorruptAdd]}" Command="{Binding AddCorruptCommand}" Padding="18,8" MinWidth="130"/>
     </Grid>
     <Grid>
      <StackPanel>
       <TextBox Text="{Binding CorruptSearch,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" ToolTip="{Binding L[ModSearch]}"/>
      <ListBox ItemsSource="{Binding AvailableCorrupted}" SelectedItem="{Binding SelectedCorrupted}" Height="150" Margin="0,8,0,0" Background="#0D1319" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" FontSize="15.5" TextWrapping="Wrap" Margin="3,3"/></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </Grid>
     <TextBlock Text="{Binding L[CurrentAugments]}" Style="{StaticResource Eyebrow}" Margin="0,16,0,8"/>
     <ItemsControl ItemsSource="{Binding Augments}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="{Binding Name}" FontSize="16.5"/><TextBlock Text="{Binding Text}" FontSize="14.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
         <Button Grid.Column="1" Content="×" Width="32" Command="{Binding RemoveCommand}" Style="{StaticResource QuietButton}" ToolTip="{Binding DataContext.L[RemoveAugment],RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <Grid Margin="0,16,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding L[AugmentSearch]}" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="{Binding L[AddMod]}" Command="{Binding AddAugmentCommand}" Padding="18,8" MinWidth="130"/>
     </Grid>
     <Grid>
      <StackPanel>
       <TextBox Text="{Binding AugmentSearch,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" ToolTip="{Binding L[AugmentSearch]}"/>
      <ListBox ItemsSource="{Binding AvailableAugments}" SelectedItem="{Binding SelectedAugment}" Height="180" Margin="0,8,0,0" Background="#0D1319" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,4"><TextBlock Text="{Binding DisplayName}" FontSize="15.5"/><TextBlock Text="{Binding Limit}" FontSize="14" Foreground="{StaticResource Gold}" Visibility="{Binding Limit,Converter={StaticResource EmptyVisibility}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </Grid>
     <TextBlock Text="{Binding AugmentPreview}" Style="{StaticResource MutedText}" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding L[ItemNotes]}" Foreground="{StaticResource Muted}" Margin="0,14,0,6"/>
    <TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" MaxLength="10000" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="{Binding L[Cancel]}" Click="CancelClick" MinWidth="120" Margin="0,0,10,0"/>
   <Button Content="{Binding L[SaveItem]}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="170"/>
  </StackPanel>
 </Grid>
</Window>
