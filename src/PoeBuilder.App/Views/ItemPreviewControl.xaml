<UserControl x:Class="PoeBuilder.App.Views.ItemPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:PoeBuilder.Core.Filters"
             Height="200" Width="200"
             HorizontalAlignment="Left" VerticalAlignment="Top">
    <UserControl.Resources>
        <Color x:Key="NormalColor">96,96,96,96</Color>
        <Color x:Key="MagicColor">64,128,200,255</Color>
        <Color x:Key="RareColor">FF,FF,255,100</Color>
        <Color x:Key="UniqueColor">FF,255,200,100</Color>
        <Color x:Key="CurrencyColor">FF,255,120,240</Color>
        <Color x:Key="GemColor">FF,150,150,255</Color>
        <Color x:Key="RelicColor">FF,200,200,150</Color>
    </UserControl.Resources>
</UserControl>