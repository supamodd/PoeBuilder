<Window x:Class="PoeBuilder.App.Views.SkillGroupEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding L[SkillEditor]}" Width="980" Height="740" MinWidth="820" MinHeight="600"
 WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
 FontFamily="Segoe UI" UseLayoutRounding="True" ShowInTaskbar="False">
 <Grid Margin="22,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="{Binding L[SkillEditor]}" FontFamily="Georgia" FontSize="22" Foreground="{StaticResource Gold}"/>
   <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Error,Converter={StaticResource EmptyVisibility}}"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,12">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="{Binding L[GroupName]}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
      <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="{Binding L[GroupWeaponSet]}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
      <ComboBox ItemsSource="{Binding WeaponSets}" SelectedItem="{Binding WeaponSet}" DisplayMemberPath="Name"/>
     </StackPanel>
    </Grid>
    <TextBlock Text="{Binding L[ActiveGem]}" Style="{StaticResource Eyebrow}" Margin="0,16,0,8"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Grid.ColumnSpan="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="56" Height="56" CornerRadius="28" BorderBrush="{Binding Active.Color,Converter={StaticResource GemBrush}}" BorderThickness="2" Background="#10161C">
       <Image Source="{Binding ActiveIcon}" Width="46" Height="46" Stretch="Uniform"/>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
       <UniformGrid Columns="2">
        <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding L[GemLevel]}" Foreground="{StaticResource Muted}" Margin="0,0,0,6" FontSize="11"/><TextBox Text="{Binding ActiveLevel,UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/></StackPanel>
        <StackPanel><TextBlock Text="{Binding L[GemQuality]}" Foreground="{StaticResource Muted}" Margin="0,0,0,6" FontSize="11"/><TextBox Text="{Binding ActiveQuality,UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/></StackPanel>
       </UniformGrid>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBox Text="{Binding ActiveSearch,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" ToolTip="{Binding L[GemSearch]}"/>
       <ListBox ItemsSource="{Binding Actives}" SelectedItem="{Binding Active}" Height="150" Margin="0,8,0,0" Background="#0D1319" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate><DataTemplate>
         <Grid Margin="2,3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image Source="{Binding Converter={StaticResource GemIcon}}" Width="28" Height="28" Stretch="Uniform"/>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
           <TextBlock Text="{Binding Name}" FontSize="12.5"/>
           <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{StaticResource Muted}"/>
          </StackPanel>
         </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </Grid>
     <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveDescription}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Width="360" Margin="0,8,0,0" VerticalAlignment="Top"/>
    </Grid>
    <TextBlock Text="{Binding Recommended}" Foreground="{StaticResource Gold}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Recommended,Converter={StaticResource EmptyVisibility}}"/>
    <Grid Margin="0,16,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding L[SupportGems]}" Style="{StaticResource Eyebrow}"/>
     <TextBlock Grid.Column="1" Text="{Binding SupportsCount}" Style="{StaticResource MutedText}" FontSize="11"/>
    </Grid>
    <ItemsControl ItemsSource="{Binding Supports}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="32" Height="32" CornerRadius="16" BorderBrush="{Binding Gem.Color,Converter={StaticResource GemBrush}}" BorderThickness="1.4" Background="#10161C">
         <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform"/>
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Gem.Name}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
        <TextBox Grid.Column="2" Text="{Binding LevelText,UpdateSourceTrigger=PropertyChanged}" MaxLength="2" VerticalAlignment="Center" Margin="10,0,4,0" ToolTip="{Binding DataContext.L[GemLevel],RelativeSource={RelativeSource AncestorType=Window}}"/>
        <TextBox Grid.Column="3" Text="{Binding QualityText,UpdateSourceTrigger=PropertyChanged}" MaxLength="2" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding DataContext.L[GemQuality],RelativeSource={RelativeSource AncestorType=Window}}"/>
        <Button Grid.Column="4" Content="×" Width="32" Command="{Binding DataContext.RemoveSupportCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}"/>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBox Text="{Binding SupportSearch,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" ToolTip="{Binding L[SupportSearch]}"/>
      <ListBox ItemsSource="{Binding AvailableSupports}" SelectedItem="{Binding SelectedSupport}" Height="150" Margin="0,8,0,0" Background="#0D1319" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
       <ListBox.ItemTemplate><DataTemplate>
        <Grid Margin="2,3">
         <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Image Source="{Binding Converter={StaticResource GemIcon}}" Width="28" Height="28" Stretch="Uniform"/>
         <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </StackPanel>
     <Button Grid.Column="1" Content="{Binding L[AddSupport]}" Command="{Binding AddSupportCommand}" VerticalAlignment="Bottom" Margin="10,0,0,8" Padding="18,8"/>
    </Grid>
    <TextBlock Text="{Binding L[ItemNotes]}" Foreground="{StaticResource Muted}" Margin="0,14,0,6"/>
    <TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" MaxLength="10000" AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto"/>
    <CheckBox Content="{Binding L[GroupEnabled]}" IsChecked="{Binding Enabled}" Foreground="{StaticResource Text}" Margin="0,12,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="{Binding L[Cancel]}" Click="CancelClick" MinWidth="120" Margin="0,0,10,0"/>
   <Button Content="{Binding L[SaveItem]}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="170"/>
  </StackPanel>
 </Grid>
</Window>
