<Window x:Class="PoeBuilder.App.Views.ImportCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoeBuilder" Width="760" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" ResizeMode="NoResize" WindowStyle="None" UseLayoutRounding="True"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource AppFont}" ShowInTaskbar="False">
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Bg}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{StaticResource Panel}" MouseLeftButtonDown="OnTitleBarMouseDown">
            <TextBlock Text="PoeBuilder" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button Content="×" Width="46" MinHeight="0" Padding="0" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Click="OnClose" ToolTip="Close"/>
        </Grid>
    <StackPanel Grid.Row="1" Margin="18,12,18,18">
        <TextBlock Text="{Binding L[ImportCodeTitle]}" FontFamily="{StaticResource AppFontBold}" FontSize="23" Foreground="{StaticResource Gold}" Margin="0,0,0,10"/>
        <TextBlock Text="{Binding L[ImportIntro]}" Foreground="#8A97A5" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TabControl Background="Transparent" BorderBrush="#2A3440">
            <TabItem Header="{Binding L[ImportTabPob]}" Margin="0,0,1,0">
                <StackPanel Margin="4,12,4,8">
                    <TextBlock Text="{Binding L[ImportPobHint]}" Foreground="#8A97A5" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PobCode,UpdateSourceTrigger=PropertyChanged}" MinHeight="120" MaxHeight="190"
                             AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="15"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="{Binding L[ImportTabJson]}">
                <StackPanel Margin="4,12,4,8">
                    <TextBlock Text="{Binding L[ImportUrlLabel]}" Foreground="#8A97A5" FontSize="15" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SourceUrl,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="15" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding L[ImportJsonLabel]}" Foreground="#8A97A5" FontSize="15" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding JsonText,UpdateSourceTrigger=PropertyChanged}" MinHeight="145" MaxHeight="230"
                             AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="15"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock Text="{Binding StatusText}" Foreground="#E0A44E" FontSize="15.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding L[ImportGo]}" Click="OnImport" Style="{StaticResource PrimaryButton}" MinWidth="110" MinHeight="32" Margin="0,0,8,0"/>
            <Button Content="{Binding L[DialogueCancel]}" Click="OnCancel" MinWidth="110" MinHeight="32"/>
        </StackPanel>
    </StackPanel>
    </Grid>
    </Border>
</Window>
