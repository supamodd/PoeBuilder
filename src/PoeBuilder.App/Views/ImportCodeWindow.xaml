<Window x:Class="PoeBuilder.App.Views.ImportCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoeBuilder" Width="640" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="#0B0F14" ResizeMode="NoResize" WindowStyle="SingleBorderWindow" UseLayoutRounding="True">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding L[ImportCodeTitle]}" FontFamily="Georgia" FontSize="19" Foreground="{StaticResource Gold}" Margin="0,0,0,10"/>
        <TextBlock Text="{Binding L[ImportIntro]}" Foreground="#8A97A5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TabControl Background="Transparent" BorderBrush="#2A3440">
            <TabItem Header="{Binding L[ImportTabPob]}">
                <StackPanel Margin="4,12,4,8">
                    <TextBlock Text="{Binding L[ImportPobHint]}" Foreground="#8A97A5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PobCode,UpdateSourceTrigger=PropertyChanged}" MinHeight="90" MaxHeight="150"
                             AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="{Binding L[ImportTabJson]}">
                <StackPanel Margin="4,12,4,8">
                    <TextBlock Text="{Binding L[ImportUrlLabel]}" Foreground="#8A97A5" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SourceUrl,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding L[ImportJsonLabel]}" Foreground="#8A97A5" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding JsonText,UpdateSourceTrigger=PropertyChanged}" MinHeight="110" MaxHeight="180"
                             AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock Text="{Binding StatusText}" Foreground="#E0A44E" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding L[ImportGo]}" Click="OnImport" Style="{StaticResource PrimaryButton}" MinWidth="110" MinHeight="32" Margin="0,0,8,0"/>
            <Button Content="{Binding L[DialogueCancel]}" Click="OnCancel" MinWidth="110" MinHeight="32"/>
        </StackPanel>
    </StackPanel>
</Window>
