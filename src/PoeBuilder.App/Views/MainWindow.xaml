<Window x:Class="PoeBuilder.App.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:controls="clr-namespace:PoeBuilder.App.Controls"
 Title="PoeBuilder Native" Icon="/PoeBuilder;component/Assets/PoeBuilder.ico" Width="1440" Height="940" MinWidth="1040" MinHeight="680"
 WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
 WindowStyle="None" ResizeMode="CanResize" FontFamily="Segoe UI" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><DataTemplate x:Key="NamedChoice"><TextBlock Text="{Binding Name}"/></DataTemplate></Window.Resources>
 <Window.InputBindings>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding ImportCommand}"/>
 </Window.InputBindings>
 <Border BorderBrush="#303943" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
   <Grid Background="#10151B">
    <TextBlock Text="POEBUILDER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Content="—" Width="46" Height="32" MinHeight="0" Padding="0" Style="{StaticResource QuietButton}" Click="MinimizeClick" ToolTip="{Binding L[Minimize]}" AutomationProperties.Name="{Binding L[Minimize]}"/>
     <Button Content="□" Width="46" Height="32" MinHeight="0" Padding="0" Style="{StaticResource QuietButton}" Click="MaximizeClick" ToolTip="{Binding L[Maximize]}" AutomationProperties.Name="{Binding L[Maximize]}"/>
     <Button Content="×" FontSize="21" Width="46" Height="32" MinHeight="0" Padding="0" Style="{StaticResource QuietButton}" Click="CloseClick" ToolTip="{Binding L[Close]}" AutomationProperties.Name="{Binding L[Close]}"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <!-- Sidebar -->
    <Border Background="#10161C" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
     <Grid Margin="18,22,18,18">
      <Grid.RowDefinitions><RowDefinition Height="98"/><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
       <StackPanel Orientation="Horizontal" Margin="8,0,0,12">
        <Viewbox Width="37" Height="43" Margin="0,0,12,0"><Canvas Width="40" Height="48">
         <Path Data="M20,1 L38,24 20,47 2,24 Z M20,8 L20,40 M8,24 L32,24 M12,13 L28,35 M28,13 L12,35" Stroke="{StaticResource Gold}" StrokeThickness="1.6"/>
         <Path Data="M20,15 L27,24 20,33 13,24 Z" Fill="{StaticResource Gold}"/>
        </Canvas></Viewbox>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="POE" FontFamily="Georgia" FontSize="21" Foreground="{StaticResource Gold}"/><TextBlock Text="BUILDER" FontSize="17" FontWeight="Bold" Margin="0,-2,0,0"/></StackPanel>
       </StackPanel>
       <TextBlock Text="{Binding Version}" FontSize="10" Foreground="{StaticResource Muted}" Margin="9,0,0,0"/>
      </StackPanel>
      <TextBlock Grid.Row="1" Text="{Binding L[Workspace]}" Style="{StaticResource Eyebrow}" Margin="10,5"/>
      <ListBox Grid.Row="2" Style="{StaticResource NavList}" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNav}" VerticalAlignment="Top" AutomationProperties.Name="{Binding L[Workspace]}">
       <ListBox.ItemTemplate><DataTemplate>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Path Data="{Binding Icon}" Width="19" Height="19" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.4"/>
         <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="13,0,0,0" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontWeight="SemiBold" FontSize="13"/>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,14">
       <StackPanel>
        <TextBlock Text="{Binding L[CurrentBuild]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
        <TextBlock Text="{Binding CurrentName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentName}"/>
        <TextBlock Text="{Binding SaveState}" Foreground="{StaticResource Gold}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <TextBlock Grid.Row="4" Text="{Binding L[Independent]}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap"/>
     </Grid>
    </Border>
    <!-- Main workspace -->
    <Grid Grid.Column="1">
     <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="30,0">
      <Grid>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding PageTitle}" FontSize="25" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
         <Ellipse Width="5" Height="5" Fill="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,7,0"/>
         <TextBlock Text="{Binding L[Alpha]}" FontSize="10" Foreground="{StaticResource Muted}"/>
        </StackPanel>
       </StackPanel>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="{Binding L[Import]}" Command="{Binding ImportCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/>
        <Button Content="{Binding L[Export]}" Command="{Binding ExportCommand}" Margin="0,0,10,0"/>
        <Button Content="{Binding L[Save]}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="115" ToolTip="Ctrl+S"/>
       </StackPanel>
      </Grid>
     </Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,26,30,24">
      <Grid>
       <!-- Library -->
       <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=Builds}">
        <Border Height="257" CornerRadius="12" ClipToBounds="True" BorderBrush="#48402F" BorderThickness="1">
         <Grid>
          <Image Source="/PoeBuilder;component/Assets/observatory.jpg" Stretch="UniformToFill" Opacity="0.8"/>
          <Border><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#F5111519" Offset="0"/><GradientStop Color="#BD111519" Offset="0.5"/><GradientStop Color="#16111519" Offset="1"/></LinearGradientBrush></Border.Background></Border>
          <StackPanel Margin="30,24" VerticalAlignment="Center" HorizontalAlignment="Left">
           <TextBlock Text="{Binding L[HeroBadge]}" Foreground="{StaticResource Gold}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,12"/>
           <TextBlock Text="{Binding L[HeroTitle]}" FontFamily="Georgia" FontSize="31" LineHeight="38"/>
           <TextBlock Text="{Binding L[HeroDescription]}" Foreground="#BABDBF" FontSize="12" Margin="0,12,0,18" MaxWidth="530" TextWrapping="Wrap"/>
           <Button Content="{Binding L[CreateBuild]}" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="22,10"/>
          </StackPanel>
         </Grid>
        </Border>
        <Border Background="#151C22" CornerRadius="7" Padding="15,12" Margin="0,16,0,26" BorderBrush="{StaticResource Line}" BorderThickness="1">
         <TextBlock Text="{Binding L[FoundationNotice]}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <Grid Margin="0,0,0,20">
         <StackPanel><TextBlock Text="{Binding L[Library]}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding L[LibrarySubtitle]}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="{Binding L[NewBuild]}" Command="{Binding NewCommand}" Margin="0,0,8,0"/>
          <Button Content="{Binding L[ImportCodeTitle]}" Command="{Binding ImportCodeCommand}" Margin="0,0,8,0"/>
          <Button Content="{Binding L[ImportFileTitle]}" Command="{Binding ImportFileCommand}"/>
         </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding L[SearchHint]}" Padding="36,11,12,11"/>
          <Path Data="M8,1 A7,7 0 1 1 7.9,1 M13,13 L19,19" Stroke="{StaticResource Muted}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False"/>
          <TextBlock Text="{Binding L[SearchHint]}" Foreground="{StaticResource Muted}" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         </Grid>
         <TextBlock Grid.Column="1" Text="{Binding BuildCount}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Grid>
        <Border Style="{StaticResource Card}" MinHeight="168" Visibility="{Binding HasNoVisibleBuilds,Converter={StaticResource BoolVisibility}}">
         <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
          <TextBlock Text="◇" FontSize="28" Foreground="{StaticResource Gold}" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,7"/>
          <TextBlock Text="{Binding L[EmptyLibraryText]}" Style="{StaticResource MutedText}" TextAlignment="Center"/>
         </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding VisibleBuilds}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="20">
           <StackPanel>
            <Grid Margin="0,0,0,15"><TextBlock Text="◇" FontSize="28" Foreground="{StaticResource Gold}"/><TextBlock Text="{Binding UpdatedUtc,StringFormat={}{0:dd.MM.yyyy}}" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,20">
             <TextBlock Text="{Binding CharacterClass}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="0,0,10,0"/>
             <TextBlock Text="{Binding DataContext.L[Level],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}"/>
             <TextBlock Text="{Binding Level}" Foreground="{StaticResource Gold}" Margin="6,0,0,0"/>
            </StackPanel>
            <WrapPanel>
             <Button Content="{Binding DataContext.L[OpenBuild],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.OpenCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="14,8" MinHeight="32" Margin="0,0,8,4"/>
             <Button Content="{Binding DataContext.L[BuildEdit],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.EditBuildCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="14,8" MinHeight="32" Margin="0,0,8,4"/>
             <Button Content="{Binding DataContext.L[ExportBuild],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.ExportBuildCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="14,8" MinHeight="32" Margin="0,0,8,4"/>
             <Button Content="{Binding DataContext.L[Duplicate],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.DuplicateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="8" MinHeight="32" Margin="0,0,4,4"/>
             <Button Content="{Binding DataContext.L[Delete],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="8" MinHeight="32" Margin="0,0,0,4"/>
            </WrapPanel>
           </StackPanel>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
       <!-- Official GGG main-tree snapshot, with explicit partial-mechanics scope. -->
       <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=Tree}" IsEnabled="{Binding CanWork}">
        <WrapPanel Margin="0,0,0,12">
         <TextBlock Text="{Binding Tree.DatasetLabel}" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding Tree.DisplayedTree.PointSummary}" VerticalAlignment="Center"/>
        </WrapPanel>
        <TextBlock Text="{Binding L[TreeDataNotice]}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12"/>
        <WrapPanel Margin="0,0,0,12">
         <StackPanel Width="160" Margin="0,0,12,8"><TextBlock Text="{Binding L[TreeClass]}" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Tree.Classes}" SelectedItem="{Binding Tree.SelectedClass}" ItemTemplate="{StaticResource NamedChoice}" IsEnabled="{Binding Tree.CanModify}" AutomationProperties.Name="{Binding L[TreeClass]}"/></StackPanel>
         <StackPanel Width="200" Margin="0,0,12,8"><TextBlock Text="{Binding L[Ascendancy]}" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Tree.AscendancyChoices}" SelectedItem="{Binding Tree.SelectedAscendancy}" ItemTemplate="{StaticResource NamedChoice}" IsEnabled="{Binding Tree.CanModify}" AutomationProperties.Name="{Binding L[Ascendancy]}"/></StackPanel>
         <StackPanel Width="165" Margin="0,0,12,8" Visibility="{Binding Tree.DisplayedTree.IsMainView,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding L[TreeDefaultAttribute]}" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Tree.DisplayedTree.AttributeChoices}" SelectedItem="{Binding Tree.DisplayedTree.DefaultAttribute}" ItemTemplate="{StaticResource NamedChoice}" AutomationProperties.Name="{Binding L[TreeDefaultAttribute]}"/></StackPanel>
         <StackPanel Margin="0,0,16,8"><TextBlock Text="{Binding L[TreeLimit]}" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding Tree.DisplayedTree.PointLimitText,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Width="70" AutomationProperties.Name="{Binding L[TreeLimit]}"/><Button Content="{Binding L[Apply]}" Command="{Binding Tree.DisplayedTree.ApplyLimitCommand}" Margin="6,0,0,0"/></StackPanel></StackPanel>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8"><Button Content="↶" FontSize="18" Padding="12,4" Command="{Binding Tree.UndoCommand}" ToolTip="{Binding L[Undo]}" AutomationProperties.Name="{Binding L[Undo]}"/><Button Content="↷" FontSize="18" Padding="12,4" Command="{Binding Tree.RedoCommand}" Margin="5,0,0,0" ToolTip="{Binding L[Redo]}" AutomationProperties.Name="{Binding L[Redo]}"/></StackPanel>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,12"><Button Content="{Binding L[MainTree]}" Command="{Binding Tree.ShowMainTreeCommand}"/><Button Content="{Binding L[AscendancyTree]}" Command="{Binding Tree.ShowAscendancyCommand}" Margin="8,0,12,0"/><TextBlock Text="{Binding Tree.ViewTitle}" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/></WrapPanel>
        <TextBlock Text="{Binding Tree.Warning}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding Tree.DisplayedTree.Warning}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="272"/></Grid.ColumnDefinitions>
         <Grid x:Name="TreeColumn"><Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,12,0">
          <Grid x:Name="WideTreeHost" Height="{Binding ActualWidth,RelativeSource={RelativeSource Self},Converter={StaticResource WideHeight}}">
           <Grid.Width><MultiBinding Converter="{StaticResource WideViewport}"><Binding ElementName="TreeColumn" Path="ActualWidth"/><Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="ActualHeight"/></MultiBinding></Grid.Width>
           <controls:TreeViewport x:Name="TreeSurface" Model="{Binding Tree.DisplayedTree}" AutomationProperties.Name="{Binding L[Tree]}"/>
           <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"><Button Content="{Binding L[TreeFocusClass]}" Command="{Binding Tree.DisplayedTree.FocusClassCommand}" Padding="10,6" FontSize="11"/><Button Content="{Binding L[TreeFit]}" Click="ResetTreeClick" Padding="10,6" FontSize="11" Margin="5,0,0,0"/></WrapPanel>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
            <Button Content="−" Click="ZoomOutClick" Width="36" Padding="0" ToolTip="{Binding L[ZoomOut]}"/>
            <Border Background="{StaticResource Panel}" Padding="12,10"><TextBlock Text="{Binding Zoom,ElementName=TreeSurface,StringFormat={}{0:P0}}" Foreground="{StaticResource Gold}" MinWidth="34" TextAlignment="Center"/></Border>
            <Button Content="+" Click="ZoomInClick" Width="36" Padding="0" ToolTip="{Binding L[ZoomIn]}"/>
           </StackPanel>
          </Grid>
         </Border></Grid>
         <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
          <ScrollViewer Height="{Binding ActualHeight,ElementName=WideTreeHost}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
           <StackPanel>
            <TextBlock Text="{Binding L[TreeSearch]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
            <TextBox Text="{Binding Tree.DisplayedTree.Search,UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="{Binding L[TreeSearch]}" ToolTip="{Binding L[TreeSearchHint]}"/>
            <TextBlock Text="{Binding Tree.DisplayedTree.SearchCount}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,6,0,8"/>
            <ListBox ItemsSource="{Binding Tree.DisplayedTree.SearchResults}" SelectedItem="{Binding Tree.DisplayedTree.SelectedResult}" Height="148" BorderThickness="0" Background="#0D1319" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding L[TreeSearch]}">
             <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,4" MaxWidth="192"><TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
             <StackPanel>
              <TextBlock Text="{Binding Tree.DisplayedTree.SelectedName}" FontFamily="Georgia" FontSize="20" Foreground="{StaticResource Gold}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Tree.DisplayedTree.SelectedStats}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,12,0,10" FontSize="12"/>
              <TextBlock Text="{Binding Tree.DisplayedTree.SelectedInfo}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12"/>
              <ComboBox ItemsSource="{Binding Tree.DisplayedTree.AttributeChoices}" SelectedItem="{Binding Tree.DisplayedTree.SelectedAttribute}" ItemTemplate="{StaticResource NamedChoice}" Visibility="{Binding Tree.DisplayedTree.HasAttribute,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Tree.CanModify}" Margin="0,0,0,12" AutomationProperties.Name="{Binding L[TreeAttribute]}"/>
              <Button Content="{Binding L[TreeAllocate]}" Command="{Binding Tree.DisplayedTree.AllocateCommand}" Style="{StaticResource PrimaryButton}" Padding="10,9"/>
              <Button Content="{Binding L[TreeRefund]}" Command="{Binding Tree.DisplayedTree.RefundCommand}" Margin="0,8,0,0" Padding="10,9"/>
              <TextBlock Text="{Binding Tree.DisplayedTree.Message}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"/>
             </StackPanel>
            </Border>
           </StackPanel>
          </ScrollViewer>
         </Border>
        </Grid>
        <TextBlock Text="{Binding L[TreeControls]}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,8"/>
        <TextBlock Text="{Binding L[TreeScope]}" Style="{StaticResource MutedText}" FontSize="11"/>
        <Button Content="{Binding L[TreeResetPlan]}" Command="{Binding Tree.ResetPlanCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource QuietButton}"/>
        <TextBlock Text="This product isn't affiliated with or endorsed by Grinding Gear Games in any way." Style="{StaticResource MutedText}" FontSize="10" Margin="0,12,0,0"/>
       </StackPanel>
       <!-- Equipment: game-inventory-like slots with bundled game icons and rarity colours. -->
       <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=Items}" IsEnabled="{Binding CanWork}">
        <TextBlock Text="{Binding L[GameDataNotice]}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding L[IconsNotice]}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding Equipment.Warning}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding Equipment.Warning,Converter={StaticResource EmptyVisibility}}"/>
        <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
         <TextBlock Text="{Binding L[WeaponSet]}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
         <Button Content="{Binding L[WeaponSet1]}" Command="{Binding Equipment.SetOneCommand}" Margin="0,0,6,0"/>
         <Button Content="{Binding L[WeaponSet2]}" Command="{Binding Equipment.SetTwoCommand}" Margin="0,0,16,0"/>
         <Button Content="↶" FontSize="16" Padding="12,4" Command="{Binding Equipment.UndoCommand}" ToolTip="{Binding L[Undo]}"/>
         <Button Content="↷" FontSize="16" Padding="12,4" Command="{Binding Equipment.RedoCommand}" Margin="5,0,0,0" ToolTip="{Binding L[Redo]}"/>
        </WrapPanel>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Style="{StaticResource Card}" Padding="16,12" VerticalAlignment="Top" Margin="0,0,12,0" HorizontalAlignment="Left">
          <StackPanel>
           <TextBlock Text="{Binding L[EquipmentSlots]}" Style="{StaticResource Eyebrow}" Margin="2,0,0,8"/>
           <Grid Width="560" Height="500">
            <TextBlock Text="I" Foreground="{StaticResource Muted}" FontSize="13" FontWeight="SemiBold" Canvas.ZIndex="0" Margin="16,74,0,0"/>
            <TextBlock Text="II" Foreground="{StaticResource Muted}" FontSize="13" FontWeight="SemiBold" Canvas.ZIndex="0" Margin="16,268,0,0"/>
            <ItemsControl ItemsSource="{Binding Equipment.Slots}">
             <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="540" Height="490"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
             <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
              <Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/>
              <Setter Property="Width" Value="{Binding Width}"/><Setter Property="Height" Value="{Binding Height}"/>
             </Style></ItemsControl.ItemContainerStyle>
             <ItemsControl.ItemTemplate><DataTemplate>
              <Button Command="{Binding DataContext.Equipment.OpenSlotCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Cursor="Hand"
               ToolTipService.InitialShowDelay="200" ToolTip="{Binding Detail,Converter={StaticResource EmptyToNull}}">

               <Grid>
                <Border CornerRadius="7" BorderThickness="1.4" BorderBrush="{Binding Accent}" Background="#0D1319">
                 <Grid>
                  <Image Source="{Binding GhostIcon}" Stretch="Uniform" Margin="12" Opacity="0.16"/>
                  <Image Source="{Binding Icon}" Stretch="Uniform" Margin="9"/>
                 </Grid>
                </Border>
                <TextBlock Text="{Binding ItemName}" FontSize="9.5" Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" MaxWidth="72" Margin="1,0,1,1" Background="#AA0D1319" Padding="2,0" ToolTip="{Binding ItemName}"/>
               </Grid>
              </Button>
             </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
           </Grid>
          </StackPanel>
         </Border>
         <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
          <StackPanel>
           <TextBlock Text="{Binding L[EquipmentInventory]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
           <TextBox Text="{Binding Equipment.Search,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,0,0,8" ToolTip="{Binding L[SearchItems]}"/>
           <ListBox ItemsSource="{Binding Equipment.Items}" SelectedItem="{Binding Equipment.SelectedItem}" Height="330" Background="#0D1319" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate>
             <Grid Margin="3,4" ToolTip="{Binding Detail, Converter={StaticResource EmptyToNull}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"/>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
               <TextBlock Text="{Binding Name}" FontSize="13" TextWrapping="Wrap"/>
               <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
             </Grid>
            </DataTemplate></ListBox.ItemTemplate>
           </ListBox>
           <WrapPanel Margin="0,10,0,10">
