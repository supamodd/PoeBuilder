<Window x:Class="PoeBuilder.App.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:controls="clr-namespace:PoeBuilder.App.Controls"
 xmlns:services="clr-namespace:PoeBuilder.App.Services"
 Title="PoeBuilder Native" Icon="pack://application:,,,/PoeBuilder;component/Assets/poebuilderICON0.7.ico" Width="1600" Height="1000" MinWidth="1160" MinHeight="720"
 WindowState="Normal" WindowStartupLocation="Manual" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
 WindowStyle="None" ResizeMode="CanResize" FontFamily="{StaticResource AppFont}" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="NamedChoice">
      <TextBlock Text="{Binding Name}"/>
    </DataTemplate>
    <DataTemplate x:Key="EquipmentSlotTemplate">
      <Grid ClipToBounds="True">
        <Border CornerRadius="7" BorderThickness="1.4" BorderBrush="{Binding Border}" Background="#0D1319">
          <Grid>
            <Image Source="{Binding GhostIcon}" Stretch="Uniform" Margin="5" Opacity="0.16"/>
            <Image Source="{Binding Icon}" Stretch="Uniform" Margin="5"/>
          </Grid>
        </Border>
        <TextBlock Text="{Binding ItemName}" FontSize="13.5" Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    TextTrimming="CharacterEllipsis" MaxWidth="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=Button}}"
                                    Margin="1,0,1,1" Background="#AA0D1319" Padding="2,0" ToolTip="{Binding ItemName}"/>
      </Grid>
    </DataTemplate>
    <Style x:Key="EquipmentSlotButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="ContentTemplate" Value="{StaticResource EquipmentSlotTemplate}"/>
      <Setter Property="Command" Value="{Binding DataContext.Equipment.OpenSlotCommand,RelativeSource={RelativeSource AncestorType=Window}}"/>
      <Setter Property="CommandParameter" Value="{Binding Content,RelativeSource={RelativeSource Self}}"/>
      <Setter Property="ToolTip" Value="{Binding Content.Detail,RelativeSource={RelativeSource Self},Converter={StaticResource EmptyToNull}}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="AllowDrop" Value="True"/>
    </Style>
    <services:BuildCardArtworkConverter x:Key="BuildCardArtwork"/>
    <!-- The one animated value behind the sidebar fold. Everything that has to move together — the rail's
         width, its margins, the icon centring, the fade of the names — reads this, so a single
         DoubleAnimation moves them as one piece instead of several triggers snapping on different frames. -->
    <services:SidebarFoldState x:Key="SidebarFoldState"/>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding ImportCommand}"/>
  </Window.InputBindings>
  <Border BorderBrush="#303943" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="34"/>
      </Grid.RowDefinitions>
      <Grid Background="#10151B">
        <TextBlock Text="POEBUILDER" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="—" Width="50" Height="40" MinHeight="0" Padding="0" Style="{StaticResource QuietButton}" Click="MinimizeClick" ToolTip="{Binding L[Minimize]}" AutomationProperties.Name="{Binding L[Minimize]}"/>
          <Button Content="□" Width="50" Height="40" MinHeight="0" Padding="0" Style="{StaticResource QuietButton}" Click="MaximizeClick" ToolTip="{Binding L[Maximize]}" AutomationProperties.Name="{Binding L[Maximize]}"/>
          <Button Content="×" FontSize="29" Width="50" Height="40" MinHeight="0" Padding="0" Style="{StaticResource QuietButton}" Click="CloseClick" ToolTip="{Binding L[Close]}" AutomationProperties.Name="{Binding L[Close]}"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <!-- Auto: the sidebar carries its own folded width (64 icons-only / 245 with the tab names),
               and the workspace simply takes whatever is left of the window. -->
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Sidebar: folded to the icons, tab names slide out on hover. ClipToBounds is what makes the fold
             smooth: the names stay laid out and are revealed by the widening rail rather than blinked on. -->
        <Border x:Name="SidebarHost" Background="#10161C" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"
                ClipToBounds="True"
                Width="{Binding Progress,Source={StaticResource SidebarFoldState},Converter={StaticResource SidebarFold},ConverterParameter=Width}"
                Margin="{Binding Progress,Source={StaticResource SidebarFoldState},Converter={StaticResource SidebarFold},ConverterParameter=Margin}"
                MouseEnter="SidebarEnter" MouseLeave="SidebarLeave"
                LostKeyboardFocus="SidebarLostKeyboardFocus">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="115"/>
              <RowDefinition Height="38"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <!-- The mark's own inset carries the centring: it is centred in the folded rail and eases to
                     the open panel's left margin as the rail widens. The artwork is the owner's logo, drawn
                     square and scaled into a 37x43 box; keep its own padding even so it stays centred. -->
                <Image Source="pack://application:,,,/PoeBuilder;component/Assets/poebuilderLOGO.0.7.png"
                       Stretch="Uniform" Width="37" Height="43"
                       Margin="{Binding Progress,Source={StaticResource SidebarFoldState},Converter={StaticResource SidebarFold},ConverterParameter=LogoInset}"/>
                <StackPanel VerticalAlignment="Center"
                          Opacity="{Binding Progress,Source={StaticResource SidebarFoldState},Converter={StaticResource SidebarFold},ConverterParameter=Opacity}">
                  <TextBlock Text="POE" FontFamily="{StaticResource AppFontBold}" FontSize="25" Foreground="{StaticResource Gold}"/>
                  <TextBlock Text="BUILDER" FontSize="21" FontWeight="Bold" Margin="0,-2,0,0"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="{Binding Version}" FontSize="14" Foreground="{StaticResource Muted}" Margin="9,0,0,0"
                         Opacity="{Binding Progress,Source={StaticResource SidebarFoldState},Converter={StaticResource SidebarFold},ConverterParameter=Opacity}"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding L[Workspace]}" Style="{StaticResource Eyebrow}" Margin="10,5"
                       Opacity="{Binding Progress,Source={StaticResource SidebarFoldState},Converter={StaticResource SidebarFold},ConverterParameter=Opacity}"/>
            <ListBox Grid.Row="2" Style="{StaticResource NavList}" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNav}" VerticalAlignment="Top" AutomationProperties.Name="{Binding L[Workspace]}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <!-- The glyph slides from the folded rail's centring to the open panel's left margin,
                         and the name fades in over the same progress: one gesture, no snap. The 19x19 box is
                         the slot every tab glyph is drawn for; a supplied PNG sits in it unchanged in size
                         (Stretch=Uniform only centres it), while the inline path is the fallback artwork. -->
                    <Grid Width="19" Height="19"
                          Margin="{Binding Progress,Source={StaticResource SidebarFoldState},Converter={StaticResource SidebarFold},ConverterParameter=IconInset}">
                      <Path Data="{Binding Icon}" Stretch="Uniform"
                            Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.4"
                            Visibility="{Binding HasGlyph,Converter={StaticResource BoolVisibility},ConverterParameter=Invert}"/>
                      <Image Source="{Binding Glyph}" Stretch="Uniform"
                             Visibility="{Binding HasGlyph,Converter={StaticResource BoolVisibility}}"/>
                    </Grid>
                    <TextBlock Text="{Binding Label}" Margin="13,0,0,0" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontWeight="SemiBold" FontSize="17"
                               Opacity="{Binding Progress,Source={StaticResource SidebarFoldState},Converter={StaticResource SidebarFold},ConverterParameter=Opacity}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,14"
                    Opacity="{Binding Progress,Source={StaticResource SidebarFoldState},Converter={StaticResource SidebarFold},ConverterParameter=Opacity}">
              <StackPanel>
                <TextBlock Text="{Binding L[CurrentBuild]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding CurrentName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentName}"/>
                <TextBlock Text="{Binding SaveState}" Foreground="{StaticResource Gold}" FontSize="15" Margin="0,7,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <TextBlock Grid.Row="4" Text="{Binding L[Independent]}" Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap"
                       Opacity="{Binding Progress,Source={StaticResource SidebarFoldState},Converter={StaticResource SidebarFold},ConverterParameter=Opacity}"/>
          </Grid>
        </Border>
        <!-- Main workspace -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="104"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="30,0">
            <Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PageTitle}" FontSize="29" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Ellipse Width="5" Height="5" Fill="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding L[Alpha]}" FontSize="14" Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{Binding L[Import]}" Command="{Binding ImportCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/>
                <Button Content="{Binding L[Export]}" Command="{Binding ExportCommand}" Margin="0,0,10,0"/>
                <Button Content="{Binding L[Save]}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="115" ToolTip="Ctrl+S"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="#11171D" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
               Padding="22,5" Visibility="{Binding HasBuild,Converter={StaticResource BoolVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding L[ProgressionStages]}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="4,0,12,0"/>
              <ListBox Grid.Column="1" ItemsSource="{Binding Editor.Stages}" SelectedValuePath="Id"
               SelectedValue="{Binding Editor.CurrentStageId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
               Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
               AutomationProperties.Name="{Binding L[ProgressionStages]}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="StageBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="StageBorder" Property="Background" Value="#29251C"/>
                              <Setter TargetName="StageBorder" Property="BorderBrush" Value="{StaticResource Gold}"/>
                              <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="StageBorder" Property="BorderBrush" Value="#71603A"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Content="+" Command="{Binding AddStageCommand}" Style="{StaticResource PrimaryButton}" Width="38" MinHeight="38" Padding="0"
               ToolTip="{Binding L[AddStage]}" AutomationProperties.Name="{Binding L[AddStage]}"/>
                <Button Grid.Column="1" Content="✎" Command="{Binding RenameStageCommand}" Style="{StaticResource QuietButton}" Width="38" MinHeight="38" Padding="0" Margin="6,0,0,0"
               ToolTip="{Binding L[RenameStage]}" AutomationProperties.Name="{Binding L[RenameStage]}"/>
                <Button Grid.Column="2" Content="×" Command="{Binding DeleteStageCommand}" Style="{StaticResource QuietButton}" Width="38" MinHeight="38" Padding="0" Margin="6,0,0,0"
               ToolTip="{Binding L[DeleteStage]}" AutomationProperties.Name="{Binding L[DeleteStage]}"/>
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,26,30,24">
            <Grid>
              <!-- Library -->
              <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=Builds}">
                <Border Height="257" CornerRadius="12" ClipToBounds="True" BorderBrush="#48402F" BorderThickness="1">
                  <Grid>
                    <Image Source="/PoeBuilder;component/Assets/my_builds_img.png" Stretch="UniformToFill" Opacity="0.8"/>
                    <Border>
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                          <GradientStop Color="#F5111519" Offset="0"/>
                          <GradientStop Color="#BD111519" Offset="0.5"/>
                          <GradientStop Color="#16111519" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <StackPanel Margin="30,24" VerticalAlignment="Center" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding L[HeroBadge]}" Foreground="{StaticResource Gold}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                      <TextBlock Text="{Binding L[HeroTitle]}" FontFamily="{StaticResource AppFont}" FontSize="35" LineHeight="38"/>
                      <TextBlock Text="{Binding L[HeroDescription]}" Foreground="#BABDBF" FontSize="16" Margin="0,12,0,18" MaxWidth="530" TextWrapping="Wrap"/>
                      <Button Content="{Binding L[CreateBuild]}" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="22,10"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Background="#151C22" CornerRadius="7" Padding="15,12" Margin="0,16,0,26" BorderBrush="{StaticResource Line}" BorderThickness="1">
                  <TextBlock Text="{Binding L[FoundationNotice]}" Foreground="{StaticResource Muted}" FontSize="16" TextWrapping="Wrap"/>
                </Border>
                <Grid Margin="0,0,0,20">
                  <StackPanel>
                    <TextBlock Text="{Binding L[Library]}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding L[LibrarySubtitle]}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding L[NewBuild]}" Command="{Binding NewCommand}" Margin="0,0,8,0"/>
                    <Button Content="{Binding L[ImportCodeTitle]}" Command="{Binding ImportCodeCommand}" Margin="0,0,8,0"/>
                    <Button Content="{Binding L[ImportFileTitle]}" Command="{Binding ImportFileCommand}"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid>
                    <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding L[SearchHint]}" Padding="36,11,12,11"/>
                    <Path Data="M8,1 A7,7 0 1 1 7.9,1 M13,13 L19,19" Stroke="{StaticResource Muted}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding L[SearchHint]}" Foreground="{StaticResource Muted}" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Search}" Value="">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style></TextBlock>
                  </Grid>
                  <TextBlock Grid.Column="1" Text="{Binding BuildCount}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </Grid>
                <Border Style="{StaticResource Card}" MinHeight="168" Visibility="{Binding HasNoVisibleBuilds,Converter={StaticResource BoolVisibility}}">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                    <TextBlock Text="◇" FontSize="32" Foreground="{StaticResource Gold}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,7"/>
                    <TextBlock Text="{Binding L[EmptyLibraryText]}" Style="{StaticResource MutedText}" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding VisibleBuilds}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="0" ClipToBounds="True" Height="250">
                        <Grid>
                          <Image Width="360" HorizontalAlignment="Right" Stretch="UniformToFill" Opacity="0.65" IsHitTestVisible="False">
                            <Image.Source>
                              <MultiBinding Converter="{StaticResource BuildCardArtwork}">
                                <Binding/>
                                <Binding Path="DataContext.Tree.Catalog" RelativeSource="{RelativeSource AncestorType=Window}"/>
                              </MultiBinding>
                            </Image.Source>
                          </Image>
                          <Border IsHitTestVisible="False">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#F20D1116" Offset="0"/>
                                <GradientStop Color="#DD0D1116" Offset="0.55"/>
                                <GradientStop Color="#8510151B" Offset="1"/>
                              </LinearGradientBrush>
                            </Border.Background>
                          </Border>
                          <StackPanel Margin="20">
                            <Grid Margin="0,0,0,15">
                              <TextBlock Text="◇" FontSize="32" Foreground="{StaticResource Gold}"/>
                              <TextBlock Text="{Binding UpdatedUtc,StringFormat={}{0:dd.MM.yyyy}}" Foreground="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,20">
                              <TextBlock Text="{Binding CharacterClass}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="0,0,10,0"/>
                              <TextBlock Text="{Binding DataContext.L[Level],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}"/>
                              <TextBlock Text="{Binding Level}" Foreground="{StaticResource Gold}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <WrapPanel>
                              <Button Content="{Binding DataContext.L[OpenBuild],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.OpenCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="14,8" MinHeight="32" Margin="0,0,8,4"/>
                              <Button Content="{Binding DataContext.L[BuildEdit],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.EditBuildCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="14,8" MinHeight="32" Margin="0,0,8,4"/>
                              <Button Content="{Binding DataContext.L[ExportBuild],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.ExportBuildCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="14,8" MinHeight="32" Margin="0,0,8,4"/>
                              <Button Content="{Binding DataContext.L[Duplicate],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.DuplicateCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="8" MinHeight="32" Margin="0,0,4,4"/>
                              <Button Content="{Binding DataContext.L[Delete],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="8" MinHeight="32" Margin="0,0,0,4"/>
                            </WrapPanel>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <!-- Equipment: game-inventory-like slots with bundled game icons and rarity colours. -->
              <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=Items}" IsEnabled="{Binding CanWork}">
                <TextBlock Text="{Binding L[GameDataNotice]}" Style="{StaticResource MutedText}" FontSize="15" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding L[IconsNotice]}" Style="{StaticResource MutedText}" FontSize="15" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding Equipment.Warning}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding Equipment.Warning,Converter={StaticResource EmptyVisibility}}"/>
                <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                  <TextBlock Text="{Binding L[WeaponSet]}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button Content="{Binding L[WeaponSet1]}" Command="{Binding Equipment.SetOneCommand}" Margin="0,0,6,0"/>
                  <Button Content="{Binding L[WeaponSet2]}" Command="{Binding Equipment.SetTwoCommand}" Margin="0,0,16,0"/>
                  <Button Content="↶" FontSize="20" Padding="12,4" Command="{Binding Equipment.UndoCommand}" ToolTip="{Binding L[Undo]}"/>
                  <Button Content="↷" FontSize="20" Padding="12,4" Command="{Binding Equipment.RedoCommand}" Margin="5,0,0,0" ToolTip="{Binding L[Redo]}"/>
                </WrapPanel>
                <Grid>
                  <!-- The slot canvas keeps its game-inventory geometry (560x500) and is scaled by the space the
              window gives it, so a maximized window shows a bigger inventory instead of a small board in a
              wide empty row. -->
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" MinWidth="520"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource Card}" Padding="16,12" VerticalAlignment="Top" Margin="0,0,12,0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="{Binding L[EquipmentSlots]}" Style="{StaticResource Eyebrow}" Margin="2,0,0,8"/>
                      <Viewbox x:Name="SlotCanvas" Grid.Row="1" Stretch="Uniform" StretchDirection="UpOnly" MaxWidth="760" MaxHeight="640"
                    HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality">
                        <Grid Width="520" Height="470">
                          <TextBlock Text="I" Foreground="{StaticResource Muted}" FontSize="17" FontWeight="SemiBold" Canvas.ZIndex="0" Margin="14,60,0,0"/>
                          <TextBlock Text="II" Foreground="{StaticResource Muted}" FontSize="17" FontWeight="SemiBold" Canvas.ZIndex="0" Margin="14,252,0,0"/>
                          <Canvas x:Name="EquipmentBoardCanvas" Width="520" Height="470" ClipToBounds="True">
                            <Button x:Name="SlotHelmet" Content="{Binding Equipment.HelmetSlot}" Canvas.Left="216" Canvas.Top="84" Width="86" Height="86" Style="{StaticResource EquipmentSlotButton}" DragOver="Slot_DragOver" DragLeave="Slot_DragLeave" Drop="Slot_Drop"/>
                            <Button x:Name="SlotAmulet" Content="{Binding Equipment.AmuletSlot}" Canvas.Left="308" Canvas.Top="160" Width="43" Height="43" Style="{StaticResource EquipmentSlotButton}" DragOver="Slot_DragOver" DragLeave="Slot_DragLeave" Drop="Slot_Drop" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Button x:Name="SlotGloves" Content="{Binding Equipment.GlovesSlot}" Canvas.Left="153" Canvas.Top="275" Width="52" Height="86" Style="{StaticResource EquipmentSlotButton}" DragOver="Slot_DragOver" DragLeave="Slot_DragLeave" Drop="Slot_Drop"/>
                            <Button x:Name="SlotBody" Content="{Binding Equipment.BodySlot}" Canvas.Left="216" Canvas.Top="176" Width="86" Height="129" Style="{StaticResource EquipmentSlotButton}" DragOver="Slot_DragOver" DragLeave="Slot_DragLeave" Drop="Slot_Drop"/>
