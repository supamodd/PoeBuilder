                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                      <StackPanel>
                        <TextBlock Text="{Binding L[ConfigEffective]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                        <CheckBox Content="{Binding L[ConfigEnemyChilled]}" IsChecked="{Binding Config.EnemyChilled}" Margin="0,0,0,7"/>
                        <CheckBox Content="{Binding L[ConfigEnemyIgnited]}" IsChecked="{Binding Config.EnemyIgnited}" Margin="0,0,0,7"/>
                        <CheckBox Content="{Binding L[ConfigEnemyBleeding]}" IsChecked="{Binding Config.EnemyBleeding}" Margin="0,0,0,7"/>
                        <CheckBox Content="{Binding L[ConfigEnemyShocked]}" IsChecked="{Binding Config.EnemyShocked}" Margin="0,0,0,7"/>
                        <CheckBox Content="{Binding L[ConfigEnemyFireExposure]}" IsChecked="{Binding Config.EnemyFireExposure}" Margin="0,0,0,7"/>
                        <CheckBox Content="{Binding L[ConfigEnemyColdExposure]}" IsChecked="{Binding Config.EnemyColdExposure}" Margin="0,0,0,7"/>
                        <CheckBox Content="{Binding L[ConfigEnemyLightningExposure]}" IsChecked="{Binding Config.EnemyLightningExposure}"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14">
                      <StackPanel>
                        <TextBlock Text="{Binding L[ConfigEnemyStats]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding L[ConfigEnemyDefaults]}" Style="{StaticResource MutedText}" FontSize="14.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                          </Grid.RowDefinitions>
                          <TextBlock Grid.Row="0" Text="{Binding L[ConfigEnemyLevel]}" VerticalAlignment="Center"/>
                          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.EnemyLevelText,UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"/>
                          <TextBlock Grid.Row="1" Text="{Binding L[ConfigEnemyFire]}" VerticalAlignment="Center"/>
                          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.EnemyFireResistText,UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"/>
                          <TextBlock Grid.Row="2" Text="{Binding L[ConfigEnemyCold]}" VerticalAlignment="Center"/>
                          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.EnemyColdResistText,UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"/>
                          <TextBlock Grid.Row="3" Text="{Binding L[ConfigEnemyLightning]}" VerticalAlignment="Center"/>
                          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.EnemyLightningResistText,UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"/>
                          <TextBlock Grid.Row="4" Text="{Binding L[ConfigEnemyChaos]}" VerticalAlignment="Center"/>
                          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Config.EnemyChaosResistText,UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"/>
                          <TextBlock Grid.Row="5" Text="{Binding L[ConfigEnemyArmour]}" VerticalAlignment="Center"/>
                          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Config.EnemyArmourText,UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"/>
                          <TextBlock Grid.Row="6" Text="{Binding L[ConfigEnemyPhysReduction]}" VerticalAlignment="Center"/>
                          <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Config.EnemyPhysicalReductionText,UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"/>
                        </Grid>
                      </StackPanel>
                    </Border>

                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="{Binding L[ConfigReset]}" Command="{Binding Config.ResetCommand}" Style="{StaticResource QuietButton}" Margin="0,0,12,0"/>
                  <TextBlock Text="{Binding Config.Status}" Foreground="{StaticResource Gold}" FontSize="15" VerticalAlignment="Center" Visibility="{Binding Config.Status,Converter={StaticResource EmptyVisibility}}"/>
                </StackPanel>

              </StackPanel>
              <!-- Character sheet: read-only result view. Left: skills with per-skill numbers; right: defence/attributes. -->
              <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=Character}">
                <Grid Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Character.ClassName}" FontFamily="{StaticResource AppFontBold}" FontSize="25" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
                    <TextBlock Text=" · " Foreground="{StaticResource Muted}" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Character.LevelText}" Foreground="{StaticResource Text}" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="16" VerticalAlignment="Center" Margin="8,2,0,0"><Run Text=" — "/><Run Text="{Binding L[CharacterSheet], Mode=OneWay}"/></TextBlock>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Character.DatasetNote}" Style="{StaticResource MutedText}" FontSize="15" Margin="0,0,0,12"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Left: skills (final numbers, expandable, read-only) -->
                  <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                      <TextBlock Text="{Binding L[SkillResultHeader]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                        <ItemsControl ItemsSource="{Binding Character.SkillDetails}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Expander Margin="0,0,0,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="Transparent">
                                <Expander.Header>
                                  <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="46"/>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" BorderBrush="{Binding Accent}" BorderThickness="1.6" Background="#10161C" ToolTip="{Binding Description,Mode=OneWay}">
                                      <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Name,Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name,Mode=OneWay}"/>
                                      <TextBlock Text="{Binding Kind,Mode=OneWay}" FontSize="14.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                      <TextBlock Text="{Binding Dps,Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Gold}" HorizontalAlignment="Right"/>
                                      <TextBlock Text="{Binding DataContext.L[DpsUnit],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                      <TextBlock Text="{Binding Dot,Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource Gold}" HorizontalAlignment="Right" Visibility="{Binding Dot,Converter={StaticResource EmptyVisibility}}"/>
                                    </StackPanel>
                                  </Grid>
                                </Expander.Header>
                                <StackPanel Margin="6,6,0,10" Background="#0A0E13">
                                  <TextBlock Text="{Binding DataContext.L[SkillResultReadonly],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,0,8"/>
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                      <Grid Margin="0,2">
                                        <TextBlock Text="{Binding DataContext.L[DpsAvgHit],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="16"/>
                                        <TextBlock Text="{Binding Avg,Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                      </Grid>
                                      <Grid Margin="0,2">
                                        <TextBlock Text="{Binding DataContext.L[SkillRateLabel],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="16"/>
                                        <TextBlock Text="{Binding Rate,Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                      </Grid>
                                      <Grid Margin="0,2">
                                        <TextBlock Text="{Binding DataContext.L[DpsCrit],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="16"/>
                                        <TextBlock Text="{Binding Crit,Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                      </Grid>
                                      <Grid Margin="0,2">
                                        <TextBlock Text="{Binding DataContext.L[DpsMana],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="16"/>
                                        <TextBlock Text="{Binding Mana,Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                      </Grid>
                                      <Grid Margin="0,2">
                                        <TextBlock Text="{Binding DataContext.L[SkillLevelLabel],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="16"/>
                                        <TextBlock Text="{Binding LevelText,Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                      </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                      <Grid Margin="0,2">
                                        <TextBlock Text="{Binding DataContext.L[DamagePhys],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="16"/>
                                        <TextBlock Text="{Binding Phys,Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                      </Grid>
                                      <Grid Margin="0,2">
                                        <TextBlock Text="{Binding DataContext.L[DamageFire],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="16"/>
                                        <TextBlock Text="{Binding Fire,Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                      </Grid>
                                      <Grid Margin="0,2">
                                        <TextBlock Text="{Binding DataContext.L[DamageCold],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="16"/>
                                        <TextBlock Text="{Binding Cold,Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                      </Grid>
                                      <Grid Margin="0,2">
                                        <TextBlock Text="{Binding DataContext.L[DamageLight],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="16"/>
                                        <TextBlock Text="{Binding Light,Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                      </Grid>
                                      <Grid Margin="0,2">
                                        <TextBlock Text="{Binding DataContext.L[DamageChaos],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="16"/>
                                        <TextBlock Text="{Binding Chaos,Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                      </Grid>
                                    </StackPanel>
                                  </Grid>
                                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding Supports.Count,Converter={StaticResource ZeroVisibility},ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding DataContext.L[SupportsInSkill],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ItemsControl ItemsSource="{Binding Supports}">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                          <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Border ToolTip="{Binding Name,Mode=OneWay}" Background="#10161C" CornerRadius="13" Width="26" Height="26" Margin="0,0,5,0" BorderBrush="#3A4552" BorderThickness="1">
                                            <Image Source="{Binding Icon}" Width="20" Height="20"/>
                                          </Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                  <TextBlock Text="{Binding Notes,Mode=OneWay}" FontSize="14" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Notes,Converter={StaticResource EmptyVisibility}}"/>
                                  <TextBlock Text="{Binding Breakdown,Mode=OneWay}" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Breakdown,Converter={StaticResource EmptyVisibility}}"/>
                                </StackPanel>
                              </Expander>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <TextBlock Text="{Binding L[NoSkillsYet]}" Style="{StaticResource MutedText}" FontSize="16" Visibility="{Binding Character.SkillDetails.Count,Converter={StaticResource ZeroVisibility}}"/>
                    </StackPanel>
                  </Border>
                  <!-- Right: everything about the character itself -->
                  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" MaxHeight="700">
                    <StackPanel>
                      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Text="{Binding L[Resources]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                          <ItemsControl ItemsSource="{Binding Character.Resources}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,3">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="170"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding Label,Mode=OneWay}" FontSize="17" Foreground="{StaticResource Muted}"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Value,Mode=OneWay}" FontSize="21" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Detail,Mode=OneWay}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Text="{Binding L[Defences]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                          <ItemsControl ItemsSource="{Binding Character.Defences}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,3">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="170"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding Label,Mode=OneWay}" FontSize="17" Foreground="{StaticResource Muted}"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Value,Mode=OneWay}" FontSize="19" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Detail,Mode=OneWay}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Text="{Binding L[Resistances]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                          <ItemsControl ItemsSource="{Binding Character.Resistances}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,4">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="110"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding Label,Mode=OneWay}" FontSize="17" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Value,Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,12,0">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding Tone,Mode=OneWay}" Value="danger">
                                            <Setter Property="Foreground" Value="#E05A4E"/>
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding Tone,Mode=OneWay}" Value="warn">
                                            <Setter Property="Foreground" Value="#D9A441"/>
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding Tone,Mode=OneWay}" Value="good">
                                            <Setter Property="Foreground" Value="#5FBF6E"/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                  <TextBlock Grid.Column="2" Text="{Binding Detail,Mode=OneWay}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Text="{Binding L[Attributes]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                          <ItemsControl ItemsSource="{Binding Character.Attributes}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,3">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="170"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding Label,Mode=OneWay}" FontSize="17" Foreground="{StaticResource Muted}"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Value,Mode=OneWay}" FontSize="19" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Detail,Mode=OneWay}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Text="{Binding Character.UnaccountedHeader,Mode=OneWay}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                          <ItemsControl ItemsSource="{Binding Character.Unaccounted}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Path=., Mode=OneWay}" FontSize="14" Foreground="{StaticResource Muted}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,1"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{Binding L[UnaccountedNote]}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0"/>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                          <TextBlock Text="{Binding L[Assumptions]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                          <ItemsControl ItemsSource="{Binding Character.Assumptions}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,2">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="• " FontSize="14.5" Foreground="{StaticResource Muted}"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Path=., Mode=OneWay}" FontSize="14.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
                <TextBlock Text="This product isn't affiliated with or endorsed by Grinding Gear Games in any way." Style="{StaticResource MutedText}" FontSize="14" Margin="0,12,0,0"/>
              </StackPanel>
              <!-- Build notes: free-form journal saved with the native build. -->
              <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=Notes}">
                <Border Style="{StaticResource Card}" Visibility="{Binding HasNoBuild,Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="{Binding L[NoBuildText]}" Style="{StaticResource MutedText}"/>
                </Border>
                <StackPanel Visibility="{Binding HasBuild,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanWork}">
                  <Grid Margin="0,0,0,22">
                    <StackPanel>
                      <TextBlock Text="{Binding L[NotesEditorLabel]}" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Gold}" Margin="0,0,0,8"/>
                      <TextBlock Text="{Binding L[NotesTitle]}" Style="{StaticResource SectionTitle}" FontSize="32"/>
                      <TextBlock Text="{Binding L[NotesSubtitle]}" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="190">
                      <TextBlock Text="{Binding Editor.Name}" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip="{Binding Editor.Name}"/>
                      <TextBlock Text="{Binding L[NotesHint]}" Foreground="{StaticResource Muted}" FontSize="14.5" Margin="0,5,0,0" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right"/>
                    </StackPanel>
                  </Grid>
                  <Grid MinHeight="530">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="18"/>
                      <ColumnDefinition Width="270"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="48"/>
                          <RowDefinition Height="38"/>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="20,0">
                          <TextBlock Text="{Binding L[NotesEditorLabel]}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L[NotesCountLabel]}" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Editor.NotesLength,StringFormat={}{0:N0} / 100 000}" Foreground="{StaticResource Gold}" FontSize="15" FontFamily="Consolas" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                        <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                        <Grid Grid.Row="1" Background="#151C22" Margin="0,0,0,1">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                            <Button Content="B" FontWeight="Bold" Width="30" MinHeight="27" Padding="0" Focusable="False"
                     Command="{x:Static EditingCommands.ToggleBold}" CommandTarget="{Binding ElementName=NotesEditor}"
                     Click="NotesFormatClick" ToolTip="{Binding L[NotesBold]}" AutomationProperties.Name="{Binding L[NotesBold]}"/>
                            <Button Content="I" FontStyle="Italic" Width="30" MinHeight="27" Padding="0" Margin="4,0,10,0" Focusable="False"
                     Command="{x:Static EditingCommands.ToggleItalic}" CommandTarget="{Binding ElementName=NotesEditor}"
                     Click="NotesFormatClick" ToolTip="{Binding L[NotesItalic]}" AutomationProperties.Name="{Binding L[NotesItalic]}"/>
                            <Border Width="1" Height="20" Background="{StaticResource Line}" Margin="0,0,12,0"/>
                            <TextBlock Text="A" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding L[NotesColorText]}"/>
                            <Button Width="21" Height="21" MinHeight="21" Padding="0" Margin="0,0,7,0" Background="{StaticResource Gold}" BorderBrush="#FFFFFF55" BorderThickness="1" Tag="#D6B47A" Focusable="False" Click="NotesColorClick" ToolTip="{Binding L[NotesColorGold]}" AutomationProperties.Name="{Binding L[NotesColorGold]}"/>
                            <Button Width="21" Height="21" MinHeight="21" Padding="0" Margin="0,0,7,0" Background="{StaticResource Danger}" BorderBrush="#FFFFFF55" BorderThickness="1" Tag="#DE8C83" Focusable="False" Click="NotesColorClick" ToolTip="{Binding L[NotesColorCoral]}" AutomationProperties.Name="{Binding L[NotesColorCoral]}"/>
                            <Button Width="21" Height="21" MinHeight="21" Padding="0" Margin="0,0,7,0" Background="#88B4D9" BorderBrush="#FFFFFF55" BorderThickness="1" Tag="#88B4D9" Focusable="False" Click="NotesColorClick" ToolTip="{Binding L[NotesColorSky]}" AutomationProperties.Name="{Binding L[NotesColorSky]}"/>
                            <Button Width="21" Height="21" MinHeight="21" Padding="0" Margin="0,0,7,0" Background="{StaticResource Green}" BorderBrush="#FFFFFF55" BorderThickness="1" Tag="#86B59A" Focusable="False" Click="NotesColorClick" ToolTip="{Binding L[NotesColorGreen]}" AutomationProperties.Name="{Binding L[NotesColorGreen]}"/>
                            <Button Width="21" Height="21" MinHeight="21" Padding="0" Background="{StaticResource Text}" BorderBrush="#FFFFFF55" BorderThickness="1" Tag="#EAE8E2" Focusable="False" Click="NotesColorClick" ToolTip="{Binding L[NotesColorText]}" AutomationProperties.Name="{Binding L[NotesColorText]}"/>
                          </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="18,12">
                          <RichTextBox x:Name="NotesEditor" TextChanged="NotesEditor_TextChanged" AcceptsReturn="True"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16"
                      FontSize="18" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource Text}" Background="#10161C"
                      BorderThickness="0" SpellCheck.IsEnabled="False" AutomationProperties.Name="{Binding L[Notes]}"/>
                          <TextBlock Text="{Binding L[NotesEmpty]}" Foreground="{StaticResource Muted}" Opacity="0.72" FontSize="18" LineHeight="23" Margin="36,34,30,30" TextWrapping="Wrap" IsHitTestVisible="False">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Editor.Notes}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" VerticalAlignment="Bottom"/>
                        <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,0">
                          <TextBlock Text="{Binding L[NotesHint]}" Foreground="{StaticResource Muted}" FontSize="14.5" VerticalAlignment="Center"/>
                        </Border>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="2">
                      <Border Background="#151C22" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                          <TextBlock Text="{Binding L[NotesSections]}" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Gold}" Margin="0,0,0,12"/>
                          <Button Content="{Binding L[NotesActSection]}" Tag="{Binding L[NotesActSection]}" Click="NotesSectionClick" HorizontalContentAlignment="Left" Style="{StaticResource QuietButton}" Padding="10,8" Margin="0,0,0,3"/>
                          <Button Content="{Binding L[NotesTreeSection]}" Tag="{Binding L[NotesTreeSection]}" Click="NotesSectionClick" HorizontalContentAlignment="Left" Style="{StaticResource QuietButton}" Padding="10,8" Margin="0,0,0,3"/>
                          <Button Content="{Binding L[NotesSkillsSection]}" Tag="{Binding L[NotesSkillsSection]}" Click="NotesSectionClick" HorizontalContentAlignment="Left" Style="{StaticResource QuietButton}" Padding="10,8" Margin="0,0,0,3"/>
                          <Button Content="{Binding L[NotesGearSection]}" Tag="{Binding L[NotesGearSection]}" Click="NotesSectionClick" HorizontalContentAlignment="Left" Style="{StaticResource QuietButton}" Padding="10,8" Margin="0,0,0,3"/>
                          <Button Content="{Binding L[NotesTipsSection]}" Tag="{Binding L[NotesTipsSection]}" Click="NotesSectionClick" HorizontalContentAlignment="Left" Style="{StaticResource QuietButton}" Padding="10,8"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </StackPanel>
              <!-- Working application settings -->
              <!-- RegEx: the trade-filter generator. It reads game data only, so unlike the planning tabs it is
                never disabled by "no build open" — which is exactly when a trader needs it. -->
              <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=RegEx}">
                <TextBlock Text="{Binding L[RegExIntro]}" Style="{StaticResource MutedText}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <Border Style="{StaticResource Card}" Visibility="{Binding RegEx.Empty,Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="{Binding L[RegExCatalogMissing]}" Style="{StaticResource MutedText}"/>
                </Border>
                <Grid Visibility="{Binding RegEx.Empty,Converter={StaticResource BoolVisibility},ConverterParameter=Invert}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*" MinWidth="520"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.05*" MinWidth="520"/>
                  </Grid.ColumnDefinitions>
                  <!-- Modifier pool -->
                  <StackPanel>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding L[RegExPick]}" Style="{StaticResource Eyebrow}"/>
                      <ComboBox Grid.Column="1" ItemsSource="{Binding RegEx.Categories}" SelectedItem="{Binding RegEx.SelectedCategory}"
                                DisplayMemberPath="Name" MinWidth="220" AutomationProperties.Name="{Binding L[RegExPick]}"/>
                    </Grid>
                    <TextBox Text="{Binding RegEx.Search,UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/>
                    <TextBlock Text="{Binding L[RegExClickHint]}" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,10"/>
                    <Border Style="{StaticResource Card}" Padding="6" MinHeight="420" MaxHeight="560">
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RegEx.Visible}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="Transparent" BorderThickness="0" Padding="8,6"
                                      MouseLeftButtonUp="RegexRowClick" MouseRightButtonUp="RegexRowClick"
                                      ToolTipService.InitialShowDelay="120" ToolTip="{Binding State}">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
                                  <Border Width="26" Height="26" CornerRadius="13" BorderBrush="{Binding MarkBrush}" BorderThickness="1.5"
                                          VerticalAlignment="Center" Background="#10161C">
                                    <TextBlock Text="{Binding Mark}" Foreground="{Binding MarkBrush}" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Border>
                                  <StackPanel Grid.Column="1" Margin="8,0,10,0">
                                    <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="13.5" Foreground="{StaticResource Muted}">
                                      <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · "/>
                                      <Run Text="{Binding DataContext.L[RegExModLevel],RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/><Run Text=" "/>
                                      <Run Text="{Binding Level, Mode=OneWay}"/>
                                    </TextBlock>
                                  </StackPanel>
                                  <!-- The bound only appears on a modifier that has a number to bound, and a value
                                       that could not be read says so instead of being applied. -->
                                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                              Visibility="{Binding HasNumber,Converter={StaticResource BoolVisibility}}">
                                    <TextBox Text="{Binding MinText,UpdateSourceTrigger=PropertyChanged}" Width="62" MaxLength="6" VerticalAlignment="Center"/>
                                    <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <TextBox Text="{Binding MaxText,UpdateSourceTrigger=PropertyChanged}" Width="62" MaxLength="6" VerticalAlignment="Center"/>
                                    <TextBlock Text="!" Foreground="{StaticResource Danger}" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"
                                               FontSize="16" Visibility="{Binding BadBound,Converter={StaticResource BoolVisibility}}"
                                               ToolTip="{Binding DataContext.L[RegExBadBound],RelativeSource={RelativeSource AncestorType=Window}}"/>
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                    <TextBlock Text="{Binding RegEx.TruncatedText}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0"
                               Visibility="{Binding RegEx.Truncated,Converter={StaticResource BoolVisibility}}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding L[RegExLogic]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <RadioButton GroupName="RegexLogic" Content="{Binding L[RegExLogicMixed]}" Tag="Mixed" Margin="0,0,14,0"
                                   Checked="RegexLogicChecked" IsChecked="{Binding RegEx.Logic,Converter={StaticResource EnumEquals},ConverterParameter=Mixed}"/>
                      <RadioButton GroupName="RegexLogic" Content="{Binding L[RegExLogicAll]}" Tag="All" Margin="0,0,14,0"
                                   Checked="RegexLogicChecked" IsChecked="{Binding RegEx.Logic,Converter={StaticResource EnumEquals},ConverterParameter=All}"/>
                      <RadioButton GroupName="RegexLogic" Content="{Binding L[RegExLogicAny]}" Tag="Any"
                                   Checked="RegexLogicChecked" IsChecked="{Binding RegEx.Logic,Converter={StaticResource EnumEquals},ConverterParameter=Any}"/>
                    </StackPanel>
                    <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                          <Setter Property="Text" Value="{Binding L[RegExLogicMixedHint]}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding RegEx.Logic}" Value="All">
                              <Setter Property="Text" Value="{Binding L[RegExLogicAllHint]}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RegEx.Logic}" Value="Any">
                              <Setter Property="Text" Value="{Binding L[RegExLogicAnyHint]}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14" MinHeight="150">
                      <StackPanel>
                        <TextBlock Text="{Binding L[RegExResult]}" Style="{StaticResource Eyebrow}"/>
                        <TextBox Text="{Binding RegEx.Output,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="15" MinHeight="96" MaxHeight="180"
                                 VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                          <Button Content="{Binding L[RegExCopy]}" Command="{Binding RegEx.CopyCommand}" Style="{StaticResource PrimaryButton}" MinWidth="150"/>
                          <Button Content="{Binding L[RegExClear]}" Command="{Binding RegEx.ClearCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Foreground="{StaticResource Muted}" FontSize="14.5"
                                 Text="{Binding RegEx.Status}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" FontSize="15" Foreground="{StaticResource Gold}" VerticalAlignment="Center">
                        <Run Text="{Binding RegEx.Length, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding RegEx.Limit, Mode=OneWay}"/>
                      </TextBlock>
                    </Grid>
                    <Border BorderBrush="{StaticResource Danger}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                            Visibility="{Binding RegEx.Overflow,Converter={StaticResource BoolVisibility}}">
                      <TextBlock Text="{Binding L[RegExOverflow]}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" FontSize="14.5"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
              <!-- Filter: the loot-filter editor. It reads no build at all — a filter belongs to no character —
                so unlike the planning tabs it is never disabled by "no build open". -->
              <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=Filter}">
                <TextBlock Text="{Binding L[FilterIntro]}" Style="{StaticResource MutedText}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" MinWidth="480"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.1*" MinWidth="560"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                      <StackPanel>
                        <Grid Margin="0,0,0,10">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding L[FilterLibrary]}" Style="{StaticResource Eyebrow}"/>
                          <Button Grid.Column="1" Content="{Binding L[FilterNew]}" Command="{Binding LootFilter.NewCommand}" Style="{StaticResource PrimaryButton}" MinHeight="34"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding LootFilter.Cards}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="Transparent" BorderThickness="0" Padding="4,3">
                                <Grid>
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                  <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="13.5" Foreground="{StaticResource Muted}"/>
                                  </StackPanel>
                                  <Button Grid.Column="1" Content="{Binding DataContext.L[FilterOpen],RelativeSource={RelativeSource AncestorType=Window}}"
                                          Command="{Binding DataContext.LootFilter.OpenCardCommand,RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}" MinHeight="30"/>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding LootFilter.LibraryStatus}" Style="{StaticResource MutedText}" FontSize="13.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding LootFilter.LibraryStatus,Converter={StaticResource EmptyVisibility}}"/>
                        <WrapPanel Margin="0,10,0,0">
                          <Button Content="{Binding L[FilterDuplicate]}" Command="{Binding LootFilter.DuplicateCommand}" Margin="0,0,6,0"/>
                          <Button Content="{Binding L[FilterDelete]}" Command="{Binding LootFilter.DeleteCommand}" Margin="0,0,6,0"/>
                          <Button Content="{Binding L[FilterSave]}" Command="{Binding LootFilter.SaveCommand}"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding L[FilterPresets]}" Style="{StaticResource Eyebrow}"/>
                      <ComboBox Grid.Column="1" MinWidth="190" DisplayMemberPath="Name" MinHeight="34"
                                ItemsSource="{Binding LootFilter.Presets}" SelectionChanged="FilterPresetChanged"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding L[FilterRulesHint]}" Style="{StaticResource MutedText}" FontSize="13.5" TextWrapping="Wrap"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                        <Button Content="{Binding L[FilterAddShow]}" Command="{Binding LootFilter.AddShowCommand}" MinHeight="34" Margin="0,0,6,0"/>
                        <Button Content="{Binding L[FilterAddHide]}" Command="{Binding LootFilter.AddHideCommand}" MinHeight="34"/>
                      </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding LootFilter.Blocks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                              <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="70" Height="30" CornerRadius="6" VerticalAlignment="Center" Background="#10161C">
                                  <TextBlock Text="{Binding KindBadge}" FontSize="13" FontWeight="Bold"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Gold}"/>
                                </Border>
                                <TextBox Grid.Column="1" Text="{Binding Comment,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="8,0"
                                         VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                  <Button Content="↑" Padding="8,2" MinWidth="28" MinHeight="26" Margin="0,0,4,0" Click="FilterMoveUp" Tag="{Binding}"/>
                                  <Button Content="↓" Padding="8,2" MinWidth="28" MinHeight="26" Margin="0,0,4,0" Click="FilterMoveDown" Tag="{Binding}"/>
                                  <Button Content="✕" Padding="8,2" MinWidth="28" MinHeight="26" Foreground="#E05A4E" Click="FilterRemoveBlock" Tag="{Binding}"/>
                                </StackPanel>
                              </Grid>
                              <CheckBox Content="{Binding DataContext.L[FilterDisabled],RelativeSource={RelativeSource AncestorType=Window}}"
                                        IsChecked="{Binding Disabled}" Foreground="{StaticResource Text}" Margin="0,0,0,8"/>
                              <ItemsControl ItemsSource="{Binding Conditions}" Tag="{Binding}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                      </Grid.ColumnDefinitions>
                                      <ComboBox Width="132" MinHeight="34" Tag="{Binding}" DisplayMemberPath="Content"
                                                ItemsSource="{Binding DataContext.Keywords,RelativeSource={RelativeSource AncestorType=Window}}"
                                                SelectedValue="{Binding Keyword}" SelectedValuePath="Content"
                                                SelectionChanged="FilterKeywordChanged"/>
                                      <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Tag="{Binding}"
                                                 Visibility="{Binding IsFlag,Converter={StaticResource BoolVisibility},ConverterParameter=Invert}"/>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsNumeric,Converter={StaticResource BoolVisibility}}">
                                          <CheckBox Content="{Binding DataContext.L[FilterUseRange],RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding UseRange}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                          <TextBox Text="{Binding MinText,UpdateSourceTrigger=PropertyChanged}" Width="56" MaxLength="6"
                                                   Visibility="{Binding UseRange,Converter={StaticResource BoolVisibility}}"/>
                                          <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                                     Visibility="{Binding UseRange,Converter={StaticResource BoolVisibility}}"/>
                                          <TextBox Text="{Binding MaxText,UpdateSourceTrigger=PropertyChanged}" Width="56" MaxLength="6"
                                                   Visibility="{Binding UseRange,Converter={StaticResource BoolVisibility}}"/>
                                        </StackPanel>
                                      </StackPanel>
                                      <Button Grid.Column="2" Content="{Binding DataContext.L[FilterRemoveCondition],RelativeSource={RelativeSource AncestorType=Window}}"
                                              Click="FilterRemoveCondition" Tag="{Binding}" MinHeight="30"/>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Button Content="{Binding DataContext.L[FilterAddCondition],RelativeSource={RelativeSource AncestorType=Window}}"
                                      Click="FilterAddCondition" Tag="{Binding}" HorizontalAlignment="Left" MinHeight="32"/>
                              <!-- Style: only a Show block carries colours, a sound, a flare and a minimap marker. -->
                              <StackPanel Tag="{Binding}" Margin="0,10,0,0" Visibility="{Binding CanStyle,Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="{Binding DataContext.L[FilterStyle],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                  <StackPanel Margin="0,0,10,8" Width="170">
                                    <TextBlock Text="{Binding DataContext.L[FilterFontColor],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FontColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="24"
                                             ToolTip="{Binding DataContext.L[FilterColorHint],RelativeSource={RelativeSource AncestorType=Window}}"/>
                                  </StackPanel>
                                  <StackPanel Margin="0,0,10,8" Width="170">
                                    <TextBlock Text="{Binding DataContext.L[FilterBorderColor],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding BorderColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="24"/>
                                  </StackPanel>
                                  <StackPanel Margin="0,0,10,8" Width="86">
                                    <TextBlock Text="{Binding DataContext.L[FilterFontSize],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" MinHeight="46"/>
                                  </StackPanel>
                                  <StackPanel Margin="0,0,10,8" Width="86">
                                    <TextBlock Text="{Binding DataContext.L[FilterBorderWidth],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding BorderWidth,UpdateSourceTrigger=PropertyChanged}" MaxLength="3"/>
                                  </StackPanel>
                                  <StackPanel Margin="0,0,10,8" Width="180">
                                    <TextBlock Text="{Binding DataContext.L[FilterSound],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Sounds}" SelectedItem="{Binding Sound}" MinHeight="46"/>
                                  </StackPanel>
                                  <StackPanel Margin="0,0,10,8" Width="180">
                                    <TextBlock Text="{Binding DataContext.L[FilterMinimapIcon],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Icons}" DisplayMemberPath="Content" MinHeight="46" SelectionChanged="FilterIconChanged"
                                              SelectedValue="{Binding MinimapIcon}" SelectedValuePath="Content"/>
                                  </StackPanel>
                                  <CheckBox Content="{Binding DataContext.L[FilterFlare],RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding Flare}"
                                            VerticalAlignment="Center" Margin="0,0,0,8"/>
                                </WrapPanel>
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <!-- Right: the file the game will read, and what is wrong with it right now. -->
                  <TabControl Grid.Column="2" Margin="0,0,0,10">
                    <TabItem Header="{Binding L[FilterTabPreview]}" MinWidth="200">
                      <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="14">
                          <StackPanel>
                            <TextBlock Text="{Binding L[FilterPreview]}" Style="{StaticResource Eyebrow}"/>
                            <TextBox Text="{Binding LootFilter.Preview,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="14" MinHeight="420" MaxHeight="620" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding LootFilter.Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" FontSize="14.5" Margin="0,10,0,0"
                                       Visibility="{Binding LootFilter.Error,Converter={StaticResource EmptyVisibility}}"/>
                            <WrapPanel Margin="0,12,0,0">
                              <Button Content="{Binding L[FilterCopy]}" Command="{Binding LootFilter.CopyCommand}" MinWidth="130" Margin="0,0,8,0"/>
                              <Button Content="{Binding L[FilterExport]}" Command="{Binding LootFilter.ExportCommand}" Style="{StaticResource PrimaryButton}" MinWidth="180" Margin="0,0,8,0"/>
                              <Button Content="{Binding L[FilterImport]}" Command="{Binding LootFilter.ImportCommand}"/>
                            </WrapPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </TabItem>
                    <TabItem Header="{Binding L[FilterTabSimulation]}" MinWidth="200">
                      <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Text="{Binding L[FilterTabSimulation]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
                          <ItemsControl ItemsSource="{Binding LootFilter.Blocks}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Background="Transparent" BorderThickness="0" Padding="4,3" Margin="0,0,0,8">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                      <TextBlock Text="{Binding Comment}" FontSize="16" TextWrapping="Wrap"/>
                                      <TextBlock Text="{Binding Summary}" FontSize="13.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,18,0,0">
                            <TextBlock Text="{Binding L[FilterRulesHint]}" Style="{StaticResource MutedText}"/>
                          </Border>
                        </StackPanel>
                      </Border>
                    </TabItem>
                  </TabControl>
                  <TextBlock Text="{Binding LootFilter.Status}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" FontSize="14.5" Margin="0,10,0,0"
                             Visibility="{Binding LootFilter.Status,Converter={StaticResource EmptyVisibility}}"/>
                </Grid>
              </StackPanel>
              <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=Settings}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                  <StackPanel>
                    <TextBlock Text="{Binding L[Appearance]}" Style="{StaticResource SectionTitle}" Margin="0,0,0,24"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding L[Language]}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding L[LanguageText]}" Style="{StaticResource MutedText}" Margin="0,5,20,0"/>
                      </StackPanel>
                      <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanWork}" AutomationProperties.Name="{Binding L[Language]}"/>
                    </Grid>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,18,0,0">
                      <TextBlock Text="{Binding L[LocaleNotice]}" Style="{StaticResource MutedText}"/>
                    </Border>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                  <StackPanel>
                    <TextBlock Text="{Binding L[Storage]}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding L[StorageText]}" Style="{StaticResource MutedText}" Margin="0,12,0,14"/>
                    <TextBlock Text="{Binding DataDirectory}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="16"/>
                    <Button Content="{Binding L[OpenFolder]}" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding L[ProjectStatus]}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding L[ProjectStatusText]}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                    <TextBlock Text="This product isn't affiliated with or endorsed by Grinding Gear Games in any way." Style="{StaticResource MutedText}" Margin="0,16,0,0" FontSize="15"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <!-- Passive tree: the whole workspace, like PoB2's own tab. The viewport fills it and every control
          floats over it — a top bar with the class/ascendancy/point controls, a left toolbar, a collapsible
          node panel on the right and the warnings along the bottom. Nothing is sized in 16:9 any more: the
          tree takes every pixel the window gives it. -->
          <Grid Grid.Row="2" Panel.ZIndex="20" Background="{StaticResource Bg}"
           Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=Tree}"
           IsEnabled="{Binding CanWork}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Top bar: the tree's own controls. It is a row of its own, so a narrow window wraps it instead of
           letting it lie over the viewport, which keeps every remaining pixel for the tree. -->
            <Border Background="#E6121720" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
              <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Tree.DatasetLabel}" Foreground="{StaticResource Gold}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0" ToolTip="{Binding L[TreeDataNotice]}"/>
                <Button Content="{Binding L[MainTree]}" Command="{Binding Tree.ShowMainTreeCommand}" Padding="10,5" FontSize="15.5" Margin="0,0,6,0"/>
                <Button Content="{Binding L[AscendancyTree]}" Command="{Binding Tree.ShowAscendancyCommand}" Padding="10,5" FontSize="15.5" Margin="0,0,14,0"/>
                <StackPanel Width="150" Margin="0,0,10,0">
                  <TextBlock Text="{Binding L[TreeClass]}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,3"/>
                  <ComboBox ItemsSource="{Binding Tree.Classes}" SelectedItem="{Binding Tree.SelectedClass}" ItemTemplate="{StaticResource NamedChoice}" IsEnabled="{Binding Tree.CanModify}" AutomationProperties.Name="{Binding L[TreeClass]}"/>
                </StackPanel>
                <StackPanel Width="190" Margin="0,0,10,0">
                  <TextBlock Text="{Binding L[Ascendancy]}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,3"/>
                  <ComboBox ItemsSource="{Binding Tree.AscendancyChoices}" SelectedItem="{Binding Tree.SelectedAscendancy}" ItemTemplate="{StaticResource NamedChoice}" IsEnabled="{Binding Tree.CanModify}" AutomationProperties.Name="{Binding L[Ascendancy]}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,0">
                  <Button Content="↶" FontSize="20" Padding="10,2" Command="{Binding Tree.UndoCommand}" ToolTip="{Binding L[Undo]}" AutomationProperties.Name="{Binding L[Undo]}"/>
                  <Button Content="↷" FontSize="20" Padding="10,2" Command="{Binding Tree.RedoCommand}" Margin="4,0,0,0" ToolTip="{Binding L[Redo]}" AutomationProperties.Name="{Binding L[Redo]}"/>
                </StackPanel>
                <TextBlock Text="{Binding Tree.DisplayedTree.ViewTitle}" Foreground="{StaticResource Gold}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="20,4,12,0"/>
                <Border Background="#9910161C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="9,5" Margin="0,2,6,0">
                  <TextBlock Text="{Binding Tree.DisplayedTree.PointSummary}" Foreground="{StaticResource Text}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                </Border>
                <Border Background="#9910161C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="9,5" Margin="0,2,6,0" Visibility="{Binding Tree.DisplayedTree.IsMainView,Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="{Binding Tree.DisplayedTree.WeaponSetOneSummary}" Foreground="#E3756B" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                </Border>
                <Border Background="#9910161C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="9,5" Margin="0,2,6,0" Visibility="{Binding Tree.DisplayedTree.IsMainView,Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="{Binding Tree.DisplayedTree.WeaponSetTwoSummary}" Foreground="{StaticResource Green}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                </Border>
              </WrapPanel>
            </Border>
            <Grid Grid.Row="1">
              <controls:TreeViewport x:Name="TreeSurface" Model="{Binding Tree.DisplayedTree}" AutomationProperties.Name="{Binding L[Tree]}"/>
              <!-- Left toolbar: everything that works on the view itself. -->
              <Border x:Name="TreeToolbar" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" Background="#D8121720" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="6">
                <StackPanel Width="104">
                  <Button Content="{Binding L[TreePanel]}" Command="{Binding Tree.TogglePanelCommand}" Padding="6,6" FontSize="15" Margin="0,0,0,5" ToolTip="{Binding L[TreePanelHint]}"/>
                  <Button Content="{Binding L[TreeFocusClass]}" Command="{Binding Tree.DisplayedTree.FocusClassCommand}" Padding="6,6" FontSize="15" Margin="0,0,0,5"/>
                  <Button Content="{Binding L[TreeFit]}" Click="ResetTreeClick" Padding="6,6" FontSize="15" Margin="0,0,0,5"/>
                  <Button Content="{Binding L[ZoomIn]}" Click="ZoomInClick" Padding="6,6" FontSize="15" Margin="0,0,0,3"/>
                  <TextBlock Text="{Binding Zoom,ElementName=TreeSurface,StringFormat={}{0:P0}}" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" FontSize="15"/>
                  <Button Content="{Binding L[ZoomOut]}" Click="ZoomOutClick" Padding="6,6" FontSize="15" Margin="0,3,0,5"/>
                  <Button Content="{Binding L[TreeResetPlan]}" Command="{Binding Tree.ResetPlanCommand}" Padding="6,6" FontSize="15" Style="{StaticResource QuietButton}"/>
                </StackPanel>
              </Border>
              <!-- Node panel: search, the selected node and its weapon-set assignment, exactly as before, now a
           floating card so the tree can use the space under it. -->
              <Border x:Name="NodePanel" HorizontalAlignment="Right" VerticalAlignment="Top" Width="322" Margin="0,12,12,12" Style="{StaticResource Card}" Padding="14"
              Visibility="{Binding Tree.ShowNodePanel,Converter={StaticResource BoolVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=Grid}}">
                  <StackPanel>
                    <TextBlock Text="{Binding L[TreeSearch]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Tree.DisplayedTree.Search,UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="{Binding L[TreeSearch]}" ToolTip="{Binding L[TreeSearchHint]}"/>
                    <TextBlock Text="{Binding Tree.DisplayedTree.SearchCount}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,6,0,8"/>
                    <ListBox ItemsSource="{Binding Tree.DisplayedTree.SearchResults}" SelectedItem="{Binding Tree.DisplayedTree.SelectedResult}" Height="148" BorderThickness="0" Background="#0D1319" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding L[TreeSearch]}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="3,4" MaxWidth="250">
                            <TextBlock Text="{Binding Name}" FontSize="16" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Summary}" FontSize="14" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                      <StackPanel>
                        <TextBlock Text="{Binding Tree.DisplayedTree.SelectedName}" FontFamily="{StaticResource AppFontBold}" FontSize="24" Foreground="{StaticResource Gold}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Tree.DisplayedTree.SelectedStats}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,12,0,10" FontSize="16"/>
                        <TextBlock Text="{Binding Tree.DisplayedTree.SelectedInfo}" Style="{StaticResource MutedText}" FontSize="15" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Tree.DisplayedTree.SelectedAttribute.Name}" Foreground="{StaticResource Gold}" FontSize="15" Margin="0,0,0,10" Visibility="{Binding Tree.DisplayedTree.HasAttribute,Converter={StaticResource BoolVisibility}}"/>
                        <!-- Weapon-set allocation of the selected node: the tree draws set I red and set II green, and only
                the active set's nodes are counted (PoB2's allocation mode + WeaponSetN condition). The tree's
                own Shift-clicks assign a node the same way. -->
                        <StackPanel Visibility="{Binding Tree.DisplayedTree.IsMainView,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
                          <TextBlock Text="{Binding L[WeaponSetAssign]}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,0,4"/>
                          <TextBlock Text="{Binding Tree.DisplayedTree.SelectedWeaponSetText}" Foreground="{StaticResource Gold}" FontSize="15" AutomationProperties.Name="{Binding L[WeaponSetAssign]}"/>
                          <WrapPanel Margin="0,6,0,0">
                            <Button Content="{Binding L[WeaponSet1]}" Command="{Binding Tree.DisplayedTree.SetWeaponSetOneCommand}" Padding="8,4" FontSize="15" Margin="0,0,5,5"/>
                            <Button Content="{Binding L[WeaponSet2]}" Command="{Binding Tree.DisplayedTree.SetWeaponSetTwoCommand}" Padding="8,4" FontSize="15" Margin="0,0,5,5"/>
                            <Button Content="{Binding L[WeaponSetBoth]}" Command="{Binding Tree.DisplayedTree.SetWeaponSetBothCommand}" Padding="8,4" FontSize="15" Margin="0,0,0,5"/>
                          </WrapPanel>
                        </StackPanel>
                        <Button Content="{Binding L[TreeAllocate]}" Command="{Binding Tree.DisplayedTree.AllocateCommand}" Style="{StaticResource PrimaryButton}" Padding="10,9"/>
                        <Button Content="{Binding L[TreeRefund]}" Command="{Binding Tree.DisplayedTree.RefundCommand}" Margin="0,8,0,0" Padding="10,9"/>
                        <TextBlock Text="{Binding Tree.DisplayedTree.Message}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="15"/>
                        <TextBlock Text="{Binding L[TreeInspectHint]}" Style="{StaticResource MutedText}" FontSize="14.5" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding L[TreeControls]}" Style="{StaticResource MutedText}" FontSize="14.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding L[TreeScope]}" Style="{StaticResource MutedText}" FontSize="14.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Border>
              <!-- Warnings along the bottom, where the viewport's own legend does not reach. -->
              <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="{Binding Tree.WarningText}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" TextAlignment="Center" Visibility="{Binding Tree.WarningText,Converter={StaticResource EmptyVisibility}}"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      </Border>
</Window>
