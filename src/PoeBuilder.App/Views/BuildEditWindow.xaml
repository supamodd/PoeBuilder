<Window x:Class="PoeBuilder.App.Views.BuildEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoeBuilder" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="#0B0F14" ResizeMode="NoResize" WindowStyle="SingleBorderWindow" UseLayoutRounding="True">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding L[BuildEdit]}" FontFamily="Georgia" FontSize="19" Foreground="{StaticResource Gold}" Margin="0,0,0,14"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding L[Name]}" Foreground="#8A97A5" FontSize="12" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Editor.Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding L[Class]}" Foreground="#8A97A5" FontSize="12" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Tree.Classes}" SelectedItem="{Binding Tree.SelectedClass}" DisplayMemberPath="Name" MinHeight="30"/>
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding L[BuildAscendancy]}" Foreground="#8A97A5" FontSize="12" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Tree.AscendancyChoices}" SelectedItem="{Binding Tree.SelectedAscendancy}" DisplayMemberPath="Name" MinHeight="30"/>
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding L[BuildLevel]}" Foreground="#8A97A5" FontSize="12" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Editor.LevelText,UpdateSourceTrigger=PropertyChanged}" MaxLength="3" Width="70" HorizontalAlignment="Left"/>
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding L[ProgressStageLabel]}" Foreground="#8A97A5" FontSize="12" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="{Binding L[BuildStageStarter]}" IsChecked="{Binding Editor.IsStarter,Mode=TwoWay}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <RadioButton Content="{Binding L[BuildStageEndgame]}" IsChecked="{Binding Editor.IsStarter,Converter={StaticResource InverseBool},Mode=TwoWay}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding L[GameVersionLabel]}" Foreground="#8A97A5" FontSize="12" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding GameVersions}" SelectedItem="{Binding Editor.GameVersion}" MinHeight="30" Width="140" HorizontalAlignment="Left"/>
        </Grid>
        <TextBlock Text="{Binding L[ProgressStageHint]}" Foreground="#8A97A5" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,12"/>
        <TextBlock Text="{Binding ErrorText}" Foreground="#E05A4E" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding L[DialogueOk]}" Click="OnAccept" Style="{StaticResource PrimaryButton}" MinWidth="110" MinHeight="32" Margin="0,0,8,0"/>
            <Button Content="{Binding L[DialogueCancel]}" Click="OnCancel" MinWidth="110" MinHeight="32"/>
        </StackPanel>
    </StackPanel>
</Window>
